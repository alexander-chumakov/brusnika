---
/**
 * AudioPlayer.astro — Real audio island (AUD-01..05)
 *
 * Single <audio> element with src swapped on track change.
 * Consumes data-audio-url from .track buttons rendered by TracksSection.astro.
 * Rendered in index.astro with client:idle after TracksSection.
 *
 * Implements:
 *   D-07 — auto-advance to next track on ended; stop after last (no loop)
 *   D-08 — ~1.5–2s gap + 0.4s fade-out between auto-advanced tracks
 *   D-09 — click playing track = pause/resume; click different = switch immediately
 *   D-10 — play/pause + next controls inside the now-playing bar
 *   D-11 — buffering state: "загружается…" + pulsing EQ while loading
 *   D-12 — × dismiss stops playback and hides bar
 */
---

<!-- NOW PLAYING BAR — real island markup (moved from TracksSection.astro) -->
<div id="now-playing" class="now-playing" aria-live="polite" aria-label="Плеер">
  <div class="np-eq" aria-hidden="true">
    <span class="np-bar"></span>
    <span class="np-bar np-bar-2"></span>
    <span class="np-bar np-bar-3"></span>
    <span class="np-bar np-bar-4"></span>
  </div>
  <div class="np-info">
    <div id="np-label" class="np-label">сейчас играет</div>
    <div id="np-title" class="np-title"></div>
  </div>
  <div id="np-index" class="np-index"></div>
  <!-- Volume control — desktop only (iOS ignores audio.volume); hidden on mobile via CSS -->
  <div class="np-volume">
    <button id="np-mute" class="icon-btn np-mute" aria-label="Без звука">
      <!-- Speaker icon (unmuted) — currentColor inherits the player palette -->
      <svg
        class="np-icon-volume"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M11 5 6 9H3v6h3l5 4V5z" fill="currentColor" stroke="none"></path>
        <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
        <path d="M18.5 6a8 8 0 0 1 0 12"></path>
      </svg>
      <!-- Muted icon (hidden by default; JS toggles) -->
      <svg
        class="np-icon-muted"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M11 5 6 9H3v6h3l5 4V5z" fill="currentColor" stroke="none"></path>
        <line x1="16" y1="9" x2="21" y2="15"></line>
        <line x1="21" y1="9" x2="16" y2="15"></line>
      </svg>
    </button>
    <input
      id="np-volume"
      class="np-volume-slider"
      type="range"
      min="0"
      max="1"
      step="0.01"
      value="1"
      aria-label="Громкость"
    />
  </div>
  <button id="np-play" class="icon-btn" aria-label="Воспроизвести">▶</button>
  <button id="np-next" class="icon-btn" aria-label="Следующий трек">→</button>
  <button id="np-close" class="icon-btn np-close" aria-label="Закрыть плеер">×</button>
</div>

<script>
  // Single <audio> element; src swapped on track change (Pattern 2 — no is:inline)
  const audio = new Audio();
  let currentIdx = -1;
  const FADE_MS = 400;
  const GAP_MS = 1500;

  // Collect only buttons that have a real CDN URL
  const trackBtns = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.track[data-audio-url]')
  ).filter((btn) => !!btn.dataset.audioUrl);

  const bar = document.getElementById('now-playing') as HTMLElement;
  const npLabel = document.getElementById('np-label') as HTMLElement;
  const npTitle = document.getElementById('np-title') as HTMLElement;
  const npIndex = document.getElementById('np-index') as HTMLElement;
  const npPlay = document.getElementById('np-play') as HTMLButtonElement;
  const npNext = document.getElementById('np-next') as HTMLButtonElement;
  const npClose = document.getElementById('np-close') as HTMLButtonElement;
  const npMute = document.getElementById('np-mute') as HTMLButtonElement;
  const npVolume = document.getElementById('np-volume') as HTMLInputElement;

  const TOTAL = trackBtns.length;

  // FIX B: user-controlled target volume. Fades and restores ramp toward this
  // value (not a hardcoded 1). 0 = muted. Persisted across the session.
  function loadUserVolume(): number {
    const stored = sessionStorage.getItem('np-user-volume');
    const parsed = stored !== null ? parseFloat(stored) : NaN;
    if (!Number.isNaN(parsed) && parsed >= 0 && parsed <= 1) return parsed;
    return 1;
  }
  let userVolume = loadUserVolume();
  // Volume before mute, so the speaker toggle can restore it
  let preMuteVolume = userVolume > 0 ? userVolume : 1;

  function updateMuteIcon() {
    if (userVolume === 0) {
      npMute.classList.add('np-mute--muted');
      npMute.setAttribute('aria-label', 'Включить звук');
    } else {
      npMute.classList.remove('np-mute--muted');
      npMute.setAttribute('aria-label', 'Без звука');
    }
  }

  type BarState = 'loading' | 'playing' | 'paused' | 'error';

  function updateBarState(state: BarState) {
    // Remove loading modifier first
    bar.classList.remove('now-playing--loading');

    if (state === 'loading') {
      npLabel.textContent = 'загружается…';
      bar.classList.add('now-playing--loading');
      npPlay.textContent = '▶';
      npPlay.setAttribute('aria-label', 'Воспроизвести');
    } else if (state === 'playing') {
      npLabel.textContent = 'сейчас играет';
      npPlay.textContent = '⏸';
      npPlay.setAttribute('aria-label', 'Пауза');
    } else if (state === 'paused') {
      npLabel.textContent = 'на паузе';
      npPlay.textContent = '▶';
      npPlay.setAttribute('aria-label', 'Воспроизвести');
    } else if (state === 'error') {
      npLabel.textContent = 'Не удалось загрузить трек. Попробуйте ещё раз.';
      npPlay.textContent = '▶';
      npPlay.setAttribute('aria-label', 'Воспроизвести');
    }

    // Show/hide next button — hidden when on last track
    if (currentIdx >= TOTAL - 1) {
      npNext.style.opacity = '0';
      npNext.style.pointerEvents = 'none';
    } else {
      npNext.style.opacity = '1';
      npNext.style.pointerEvents = '';
    }

    // Update active row visual
    trackBtns.forEach((btn, i) => {
      if (i === currentIdx && (state === 'playing' || state === 'loading')) {
        btn.classList.add('track--playing');
        const playLabel = btn.querySelector('.track-play');
        if (playLabel) playLabel.textContent = '▶ играет';
      } else {
        btn.classList.remove('track--playing');
        const playLabel = btn.querySelector('.track-play');
        if (playLabel) playLabel.textContent = '▶ слушать';
      }
    });
  }

  function showBar(idx: number) {
    npTitle.textContent = trackBtns[idx].dataset.title ?? '';
    npIndex.textContent = `трек ${String(idx + 1).padStart(2, '0')} / ${String(TOTAL).padStart(2, '0')}`;
    bar.style.display = 'flex';
  }

  function hideBar() {
    bar.style.display = 'none';
    trackBtns.forEach((btn) => {
      btn.classList.remove('track--playing');
      const playLabel = btn.querySelector('.track-play');
      if (playLabel) playLabel.textContent = '▶ слушать';
    });
    currentIdx = -1;
  }

  function fadeOut(onComplete: () => void) {
    if (audio.paused || audio.volume === 0) {
      onComplete();
      return;
    }
    const step = audio.volume / (FADE_MS / 50);
    const timer = setInterval(() => {
      audio.volume = Math.max(0, audio.volume - step);
      if (audio.volume <= 0) {
        clearInterval(timer);
        setTimeout(onComplete, GAP_MS);
      }
    }, 50);
  }

  function playTrack(idx: number) {
    if (idx < 0 || idx >= TOTAL) return;

    // D-09: same track while playing → pause
    if (idx === currentIdx && !audio.paused) {
      audio.pause();
      updateBarState('paused');
      return;
    }

    // D-09: same track while paused → resume from current position
    if (idx === currentIdx && audio.paused) {
      audio.volume = userVolume;
      audio.play().catch(() => updateBarState('error'));
      updateBarState('playing');
      return;
    }

    // Different track: fade out current, then load new
    fadeOut(() => {
      currentIdx = idx;
      audio.src = trackBtns[idx].dataset.audioUrl!;
      audio.load(); // Pitfall 6: load before play
      audio.volume = userVolume;
      showBar(idx);
      updateBarState('loading');
      audio.play().catch(() => updateBarState('error'));
    });
  }

  // D-07/D-08: auto-advance on track end
  audio.addEventListener('ended', () => {
    if (currentIdx < TOTAL - 1) {
      setTimeout(() => playTrack(currentIdx + 1), GAP_MS);
    } else {
      hideBar();
    }
  });

  // D-11: buffering state
  audio.addEventListener('waiting', () => updateBarState('loading'));

  // Restore volume and update state when audio actually starts playing
  audio.addEventListener('playing', () => {
    audio.volume = userVolume;
    updateBarState('playing');
  });

  // Pause state from external sources (e.g. another tab taking audio)
  audio.addEventListener('pause', () => {
    // Only update if not loading a new track (which triggers pause internally)
    if (audio.src && currentIdx !== -1 && !bar.classList.contains('now-playing--loading')) {
      updateBarState('paused');
    }
  });

  // D-10: bar play/pause button
  npPlay.addEventListener('click', () => {
    if (currentIdx === -1) return;
    if (audio.paused) {
      audio.volume = userVolume;
      audio.play().catch(() => updateBarState('error'));
    } else {
      audio.pause();
      updateBarState('paused');
    }
  });

  // D-10: bar next button
  npNext.addEventListener('click', () => {
    if (currentIdx < TOTAL - 1) {
      playTrack(currentIdx + 1);
    }
  });

  // D-12: dismiss — pause BEFORE clearing src (Anti-pattern: src='' without pause causes AbortError)
  npClose.addEventListener('click', () => {
    audio.pause();
    audio.src = '';
    hideBar();
  });

  // FEATURE: brusnika SNOWFALL — the real brand berry SVG (public/favicon.svg)
  // drifts down like gentle snow, then SETTLES onto the now-playing bar and
  // fades out. HERO «слушать» CTA ONLY (not track clicks, never auto-advance).
  // Smooth and calm — a soft diagonal drift with a few degrees of slow tilt,
  // no jittery oscillation.
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  );

  function bloom() {
    // Accessibility: skip entirely when reduced motion is requested
    if (prefersReducedMotion.matches) return;

    const layer = document.createElement('div');
    layer.className = 'bloom-layer';
    layer.setAttribute('aria-hidden', 'true');

    // Berries fall and softly SETTLE on the now-playing bar, then each rests a
    // beat and fades GENTLY + INDIVIDUALLY. Because landings are staggered, the
    // fades are naturally staggered too — a soft continuous dissolve, never a
    // synchronized hold-then-blink. Measure the bar's top edge now; fall back
    // to (viewport height − ~72px bar height) if not laid out yet.
    const barRect = bar.getBoundingClientRect();
    const landY =
      barRect.height > 0 && barRect.top > 0
        ? barRect.top
        : window.innerHeight - 72;

    const COUNT = 18 + Math.floor(Math.random() * 7); // 18–24 berries
    let maxLife = 0;

    for (let i = 0; i < COUNT; i++) {
      // Real brand asset — unmistakably brusnika. Decorative → aria-hidden.
      const berry = document.createElement('img');
      berry.className = 'bloom-berry';
      berry.src = '/favicon.svg';
      berry.alt = '';
      berry.setAttribute('aria-hidden', 'true');

      // NATURAL VARIATION between berries so no two move alike (kills "robotic").
      const size = 38 + Math.random() * 30; // 38–68px, varied
      const scale = 0.75 + Math.random() * 0.6; // 0.75–1.35 depth/parallax
      const opacity = 0.6 + Math.random() * 0.4; // 0.6–1 depth/parallax
      const startX = Math.random() * 100; // full-width random position (%)
      const sway = 28 + Math.random() * 44; // 28–72px buoyant balloon-ish arc
      const swayDir = Math.random() < 0.5 ? -1 : 1; // swing L or R first
      const spin = (Math.random() - 0.5) * 28; // slow lazy tumble (±14deg)
      // SCATTER the emergence so they don't fall in one rank:
      //  • WIDER time stagger over ~1.2s, but starting at ~0s so the very first
      //    berries still appear the instant of click (no click→appear lag).
      const delay = (i === 0 ? 0 : Math.random() * 1.2); // 0–1.2s, first at 0
      //  • VARIED vertical start above the top edge so even same-moment berries
      //    are NOT aligned on one horizontal line.
      const startY = -10 - Math.random() * 25; // −10vh … −35vh
      const fall = 2.5 + Math.random() * 1; // 2.5–3.5s unhurried natural descent
      const rest = 0.25 + Math.random() * 0.4; // brief rest on the bar (0.25–0.65s)
      const fade = 0.7 + Math.random() * 0.6; // 0.7–1.3s gentle individual fade
      // berry settles slightly above the bar line (account for its size)
      const restY = landY - size * scale * 0.5;
      maxLife = Math.max(maxLife, delay + fall + rest + fade);

      berry.style.setProperty('--size', `${size}px`);
      berry.style.setProperty('--scale', String(scale));
      berry.style.setProperty('--berry-opacity', String(opacity));
      berry.style.setProperty('--x', `${startX}%`);
      berry.style.setProperty('--start-y', `${startY}vh`);
      berry.style.setProperty('--sway', `${swayDir * sway}px`);
      berry.style.setProperty('--sway2', `${-swayDir * sway}px`);
      berry.style.setProperty('--sway3', `${swayDir * sway * 0.55}px`);
      berry.style.setProperty('--spin', `${spin}deg`);
      berry.style.setProperty('--rest-y', `${restY}px`);
      berry.style.setProperty('--delay', `${delay}s`);
      // single timeline duration = fall + rest + fade; phase split as % below
      berry.style.setProperty('--fall', `${fall}s`);
      berry.style.setProperty('--rest', `${rest}s`);
      berry.style.setProperty('--fade', `${fade}s`);
      berry.style.setProperty('--dur', `${fall + rest + fade}s`);

      layer.appendChild(berry);
    }

    document.body.appendChild(layer);
    // Auto-remove after the last berry has dissolved (no DOM buildup)
    setTimeout(() => layer.remove(), Math.ceil(maxLife * 1000) + 200);
  }

  // Wire track buttons — playback only, NO berries (CHANGE 1: hero-only)
  trackBtns.forEach((btn, idx) => {
    btn.addEventListener('click', () => playTrack(idx));
  });

  // FIX A: Hero «слушать» CTA starts the first track through the same code
  // path as the track list (same fade-in, now-playing bar appears, index
  // shows "трек 01 / 06"). Prevent the default #music jump. Bind once the
  // island hydrates; robust if hero rendered before the island.
  // CHANGE 1: the brusnika snowfall fires ONLY here (hero «слушать»), AND only
  // when this click STARTS playback (off→on) — never when it pauses/stops.
  const heroCta = document.querySelector<HTMLAnchorElement>('[data-play-first]');
  if (heroCta && TOTAL > 0) {
    heroCta.addEventListener('click', (e) => {
      e.preventDefault();
      // playTrack(0) pauses only when track 0 is already the current, playing
      // track (D-09 toggle). Any other state results in playback STARTING.
      const willStart = !(currentIdx === 0 && !audio.paused);
      if (willStart) bloom();
      playTrack(0);
    });
  }

  // FIX B: volume control wiring (desktop only; hidden on mobile via CSS).
  // Drives userVolume; live-applies to audio.volume during playback.
  function applyUserVolume(v: number, persist = true) {
    userVolume = Math.min(1, Math.max(0, v));
    npVolume.value = String(userVolume);
    // Only apply live if not mid-fade (loading state ramps on its own)
    if (!bar.classList.contains('now-playing--loading')) {
      audio.volume = userVolume;
    }
    if (userVolume > 0) preMuteVolume = userVolume;
    updateMuteIcon();
    if (persist) sessionStorage.setItem('np-user-volume', String(userVolume));
  }

  // Initialize slider + icon from persisted/default value
  applyUserVolume(userVolume, false);

  npVolume.addEventListener('input', () => {
    applyUserVolume(parseFloat(npVolume.value));
  });

  // Speaker icon toggles mute/unmute, restoring the pre-mute level
  npMute.addEventListener('click', () => {
    if (userVolume > 0) {
      preMuteVolume = userVolume;
      applyUserVolume(0);
    } else {
      applyUserVolume(preMuteVolume > 0 ? preMuteVolume : 1);
    }
  });
</script>

<style>
  /* NOW PLAYING BAR — copied verbatim from TracksSection.astro lines 222-298 + icon-btn + loading modifier */
  .now-playing {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    backdrop-filter: blur(16px);
    background: rgba(6, 6, 6, 0.92);
    border-top: 1px solid rgba(243, 169, 189, 0.4);
    padding: 12px 28px;
    align-items: center;
    gap: 20px;
  }

  .np-eq {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 22px;
  }

  .np-bar {
    width: 3px;
    height: 100%;
    background: var(--color-accent);
    border-radius: 2px;
    transform-origin: bottom;
    animation: eq 1s ease-in-out infinite;
  }

  .np-bar-2 {
    animation-duration: 1.1s;
    animation-delay: 0.2s;
  }

  .np-bar-3 {
    animation-duration: 0.9s;
    animation-delay: 0.4s;
  }

  .np-bar-4 {
    animation-duration: 1.2s;
    animation-delay: 0.1s;
  }

  /* D-11: buffering state — slow opacity pulse, no height animation */
  .now-playing--loading .np-bar {
    animation: eq-pulse 1.4s ease-in-out infinite;
  }

  .now-playing--loading .np-bar-2 {
    animation-duration: 1.6s;
    animation-delay: 0.3s;
  }

  .now-playing--loading .np-bar-3 {
    animation-duration: 1.3s;
    animation-delay: 0.1s;
  }

  .now-playing--loading .np-bar-4 {
    animation-duration: 1.5s;
    animation-delay: 0.2s;
  }

  @keyframes eq-pulse {
    0%, 100% { opacity: 0.3; height: 40%; }
    50% { opacity: 0.7; height: 50%; }
  }

  .np-info {
    flex: 1;
    min-width: 0;
  }

  .np-label {
    font-size: 12px;
    color: var(--color-text-subtle);
    letter-spacing: 0.5px;
  }

  .np-title {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .np-index {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-dim);
    white-space: nowrap;
  }

  /* FIX B: volume control — desktop only (iOS ignores audio.volume) */
  .np-volume {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  /* Mute button — inline SVG (no system emoji); inherits palette via currentColor */
  .np-mute {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .np-mute:hover {
    color: var(--color-accent);
  }

  .np-mute svg {
    display: block;
  }

  /* Toggle which SVG shows; default = unmuted speaker */
  .np-mute .np-icon-muted {
    display: none;
  }

  .np-mute--muted .np-icon-volume {
    display: none;
  }

  .np-mute--muted .np-icon-muted {
    display: block;
  }

  .np-mute--muted {
    color: var(--color-text-dim);
  }

  .np-volume-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 78px;
    height: 4px;
    border-radius: 2px;
    background: rgba(243, 169, 189, 0.22);
    cursor: pointer;
    outline: none;
  }

  .np-volume-slider:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: 4px;
  }

  .np-volume-slider::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background: rgba(243, 169, 189, 0.22);
  }

  .np-volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    margin-top: -4px; /* center 12px thumb on the 4px track */
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(243, 169, 189, 0.18);
    cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s;
  }

  .np-volume-slider:hover::-webkit-slider-thumb {
    background: var(--color-accent-hover);
    box-shadow: 0 0 0 4px rgba(243, 169, 189, 0.24);
  }

  .np-volume-slider::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: rgba(243, 169, 189, 0.22);
  }

  .np-volume-slider::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: none;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(243, 169, 189, 0.18);
    cursor: pointer;
    transition: background 0.2s;
  }

  .np-volume-slider:hover::-moz-range-thumb {
    background: var(--color-accent-hover);
  }

  /* Hide the volume control on mobile — iOS ignores programmatic audio.volume */
  @media (max-width: 860px) {
    .np-volume {
      display: none;
    }
  }

  /* 44px touch target for all icon buttons (D-10, UI-SPEC) */
  .icon-btn {
    all: unset;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: 20px;
    line-height: 1;
    flex-shrink: 0;
  }

  .icon-btn:hover {
    color: var(--color-text);
  }

  .np-close {
    font-size: 22px;
    padding: 0;
  }

  /* prefers-reduced-motion: stop EQ height animation, keep opacity */
  @media (prefers-reduced-motion: reduce) {
    .np-bar,
    .np-bar-2,
    .np-bar-3,
    .np-bar-4 {
      animation: none;
      height: 40%;
    }

    .now-playing--loading .np-bar,
    .now-playing--loading .np-bar-2,
    .now-playing--loading .np-bar-3,
    .now-playing--loading .np-bar-4 {
      animation: none;
      opacity: 0.5;
    }
  }

</style>

<!--
  FEATURE: brusnika snowfall — MUST be global. Berry <img> nodes are created
  with document.createElement and appended to document.body, so they never
  receive Astro's component scope hash. Scoped selectors would not match →
  invisible. This block is :global so the JS-created nodes are styled/animated.
-->
<style is:global>
  .bloom-layer {
    position: fixed;
    inset: 0;
    z-index: 61; /* above page content; pointer-events:none keeps it click-through */
    pointer-events: none;
    overflow: hidden;
  }

  /* Each particle is the real brand berry SVG (public/favicon.svg). ONE
     per-berry CSS keyframe timeline (berry-fall), driven by a single animation
     with one --delay and fill `both`. Because EACH berry has its OWN delay,
     duration and variation, the landings — and therefore the fades — are
     naturally STAGGERED: a soft continuous dissolve, never a synchronized
     hold-then-blink. The 0% keyframe is off-screen above the top at opacity 0,
     so a delayed berry holds that invisible state during its delay → it can
     never flash pre-placed on the player.
       0% → ~10%  : off-screen above top, fade in near the top
       ~10% → 62% : unhurried buoyant descent, gentle sway + slow lazy tumble
       62% → 72%  : soft settle onto the bar (tiny cushion, no sharp bounce)
       72% → 100% : brief rest, then gentle individual fade-out on the bar
     ease-in-out + per-berry variation is what makes it feel organic. The phase
     split is fixed % tuned to dur ≈ fall(~62%) + rest(~10%) + fade(~28%). */
  .bloom-berry {
    position: absolute;
    top: 0;
    left: var(--x);
    width: var(--size);
    height: var(--size);
    opacity: 0;
    will-change: transform, opacity;
    transform-origin: center;
    animation: berry-fall var(--dur) ease-in-out var(--delay) both;
  }

  @keyframes berry-fall {
    0% {
      opacity: 0;
      /* off-screen above the top edge at a VARIED height (--start-y) so berries
         don't enter on one horizontal line; invisible during the pre-fall delay */
      transform: translate(var(--sway), var(--start-y)) rotate(0deg)
        scale(var(--scale));
    }
    10% {
      /* fade in as it enters near the top */
      opacity: var(--berry-opacity);
    }
    34% {
      transform: translate(var(--sway2), calc(var(--rest-y) * 0.32))
        rotate(calc(var(--spin) * 0.35)) scale(var(--scale));
    }
    52% {
      transform: translate(var(--sway), calc(var(--rest-y) * 0.62))
        rotate(calc(var(--spin) * 0.65)) scale(var(--scale));
    }
    62% {
      opacity: var(--berry-opacity);
      /* arrive at the bar line */
      transform: translate(var(--sway3), var(--rest-y))
        rotate(var(--spin)) scale(var(--scale));
    }
    68% {
      /* soft cushion as it settles (no sharp bounce) */
      transform: translate(calc(var(--sway3) * 0.6), calc(var(--rest-y) + 5px))
        rotate(calc(var(--spin) * 0.95)) scale(calc(var(--scale) * 0.99));
    }
    72% {
      opacity: var(--berry-opacity);
      /* come to rest on the bar */
      transform: translate(calc(var(--sway3) * 0.4), calc(var(--rest-y) + 2px))
        rotate(calc(var(--spin) * 0.95)) scale(var(--scale));
    }
    82% {
      /* brief rest fully visible on the bar before fading */
      opacity: var(--berry-opacity);
      transform: translate(calc(var(--sway3) * 0.4), calc(var(--rest-y) + 2px))
        rotate(calc(var(--spin) * 0.95)) scale(var(--scale));
    }
    100% {
      /* gentle individual fade-out, settling a hair lower */
      opacity: 0;
      transform: translate(calc(var(--sway3) * 0.4), calc(var(--rest-y) + 6px))
        rotate(calc(var(--spin) * 0.95)) scale(var(--scale));
    }
  }

  /* Accessibility belt-and-braces: even if a node slips through, no motion */
  @media (prefers-reduced-motion: reduce) {
    .bloom-layer {
      display: none;
    }
  }
