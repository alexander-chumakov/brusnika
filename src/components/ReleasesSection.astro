---
/**
 * ReleasesSection.astro — Full-discography releases hero slideshow with
 * strict per-year filtering.
 *
 * Canonical design: claude_design_releases/_x/main.dc.html (lines 199–276, 614–642).
 * 19 releases across 6 years; only 3 carry photos — the rest render as
 * themed striped placeholder tiles (--rel-a / --rel-b / --rel-fg tokens
 * from global.css, no redefinition here).
 *
 * Year selector is a STRICT FILTER:
 *   - Picking a year shows ONLY that year's releases.
 *   - Prev/next arrows wrap modulo that year's item count (never cross years).
 *   - Autoplay (6 s) runs within the active year and pauses on hover.
 *   - prefers-reduced-motion: no autoplay, no fill animation; arrows still work.
 *
 * Section id="music" so Nav «релизы» → #music anchor still works.
 * TracksSection (singles list) renders directly below in index.astro — do NOT touch.
 */
import { Image } from 'astro:assets';
import { releases } from '../data/releases.ts';

const years = [...new Set(releases.map((r) => r.year))].sort().reverse();
const byYear = years.map((y) => ({ year: y, items: releases.filter((r) => r.year === y) }));
const defaultYear = years[0];

// Plain object (JSON-serialisable) for define:vars injection into the inline script
const yearCountsMap: Record<string, number> = Object.fromEntries(
  byYear.map((g) => [g.year, g.items.length])
);
---

<section id="music" class="releases-section">
  <div class="rel-container">

    <!-- ── Header: eyebrow label + year selector ── -->
    <div data-reveal class="rel-header">
      <span class="rel-header-eyebrow">релизы</span>

      <div class="rel-year-wrap">
        <button
          id="rel-year-btn"
          class="rel-year-btn"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-label="Выбрать год"
        >
          <span id="rel-year-label" class="rel-year-label">{defaultYear}</span>
          <span id="rel-caret" class="rel-caret" aria-hidden="true">▾</span>
        </button>

        <!-- Dropdown lists ALL 6 years; JS highlights the active one -->
        <div id="rel-year-menu" class="rel-year-menu" role="listbox" aria-label="Год релиза">
          {years.map((year, i) => (
            <button
              class={`rel-year-opt${i === 0 ? ' active' : ''}`}
              data-year={year}
              role="option"
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              {year}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- ── Hero banner ── -->
    <div id="rel-banner" data-reveal class="rel-banner">

      <!-- One year-panel per year; only the first (active) is displayed initially -->
      {byYear.map(({ year, items }, yi) => (
        <div
          class="rel-year-panel"
          data-year={year}
          style={yi !== 0 ? 'display:none' : undefined}
        >
          <div class="rel-track">
            {items.map((item) => (
              <div class="rel-slide">
                {item.cover && item.image ? (
                  <Fragment>
                    {/* ── COVER MODE: blurred bg + sharp square + text ── */}
                    {/* Blurred background — decorative, may crop */}
                    <img
                      src={item.image.src}
                      alt=""
                      aria-hidden="true"
                      class="rel-cover-bg"
                    />
                    {/* Dark overlay for text contrast */}
                    <div class="rel-cover-overlay" aria-hidden="true"></div>
                    {/* Foreground row */}
                    <div class="rel-cover-row">
                      {/* Text block */}
                      <div class="rel-cover-text">
                        <span class="rel-slide-eyebrow">{item.eyebrow}</span>
                        <h2 class="rel-slide-title">{item.title}</h2>
                        {item.desc && <p class="rel-slide-desc">{item.desc}</p>}
                        <div class="rel-slide-actions">
                          <a
                            href={item.url}
                            target="_blank"
                            rel="noopener"
                            class="rel-slide-cta"
                          >▶ слушать</a>
                          <span class="rel-slide-meta">{item.meta}</span>
                        </div>
                      </div>
                      {/* Sharp full cover square — no crop */}
                      <div class="rel-cover-square-wrap">
                        <Image
                          src={item.image}
                          alt={`внимание брусника! — ${item.title}`}
                          widths={[340, 680]}
                          sizes="(max-width: 760px) clamp(150px,42vw,210px), clamp(190px,30vw,340px)"
                          format="webp"
                          quality={90}
                          loading="lazy"
                          class="rel-cover-square-img"
                        />
                      </div>
                    </div>
                  </Fragment>
                ) : item.image ? (
                  <Fragment>
                    {/* ── PHOTO MODE (unchanged) ── */}
                    <Image
                      src={item.image}
                      alt={`внимание брусника! — ${item.title}`}
                      widths={[768, 1180]}
                      sizes="(max-width: 860px) 100vw, 1180px"
                      format="webp"
                      quality={85}
                      loading="lazy"
                      class="rel-slide-img"
                      style={`object-position: ${item.imagePosition ?? 'center'}`}
                    />
                    <div class="rel-slide-grad" aria-hidden="true"></div>
                    <div class="rel-slide-content">
                      <span class="rel-slide-eyebrow">{item.eyebrow}</span>
                      <h2 class="rel-slide-title">{item.title}</h2>
                      {item.desc && <p class="rel-slide-desc">{item.desc}</p>}
                      <div class="rel-slide-actions">
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener"
                          class="rel-slide-cta"
                        >▶ слушать</a>
                        <span class="rel-slide-meta">{item.meta}</span>
                      </div>
                    </div>
                  </Fragment>
                ) : (
                  <Fragment>
                    {/* ── PLACEHOLDER MODE (unchanged) ── */}
                    {/* Themed striped tile — readable in both day + night via CSS tokens */}
                    <div class="rel-slide-placeholder" aria-hidden="true">
                      <div class="rel-slide-placeholder-dot"></div>
                    </div>
                    <div class="rel-slide-content rel-slide-content--placeholder">
                      <span class="rel-slide-eyebrow">{item.eyebrow}</span>
                      <h2 class="rel-slide-title">{item.title}</h2>
                      {item.desc && <p class="rel-slide-desc">{item.desc}</p>}
                      <div class="rel-slide-actions">
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener"
                          class="rel-slide-cta"
                        >▶ слушать</a>
                        <span class="rel-slide-meta">{item.meta}</span>
                      </div>
                    </div>
                  </Fragment>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}

      <!-- Progress bar container — rebuilt by JS per active year's item count -->
      <div id="rel-progress" class="rel-progress" aria-hidden="true"></div>

      <!-- Prev / next arrows -->
      <div class="rel-arrows">
        <button id="rel-prev" class="rel-arrow-btn" aria-label="предыдущий релиз">←</button>
        <button id="rel-next" class="rel-arrow-btn" aria-label="следующий релиз">→</button>
      </div>

    </div><!-- /rel-banner -->
  </div><!-- /rel-container -->

  <!-- Full-screen invisible overlay: closes the year dropdown on outside click -->
  <div id="rel-overlay" class="rel-overlay" aria-hidden="true"></div>
</section>

<!-- ── Slideshow state machine ──
     define:vars makes this an inline script; no TypeScript syntax allowed.
     yearsArr and yearCountsMap are injected as const declarations by Astro.
-->
<script define:vars={{ yearsArr: years, yearCountsMap }}>
  // yearsArr: string[]  e.g. ["2026","2025","2024","2023","2022","2021"]
  // yearCountsMap: Record<string,number>  e.g. {"2026":3,"2025":6,...}

  const banner     = document.getElementById('rel-banner');
  const yearBtn    = document.getElementById('rel-year-btn');
  const yearLbl    = document.getElementById('rel-year-label');
  const caretEl    = document.getElementById('rel-caret');
  const yearMenu   = document.getElementById('rel-year-menu');
  const overlay    = document.getElementById('rel-overlay');
  const prevBtn    = document.getElementById('rel-prev');
  const nextBtn    = document.getElementById('rel-next');
  const progressEl = document.getElementById('rel-progress');

  if (!banner || !yearBtn || !yearLbl || !yearMenu || !progressEl) {
    // Component not present on this page — nothing to do
  } else {
    const yearOpts = Array.from(yearMenu.querySelectorAll('.rel-year-opt'));
    const reduced  = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let activeYearIdx = 0;
    let slide = 0;
    let timer = null;

    // ── helpers ──────────────────────────────────────────────────────────
    function activeYear()  { return yearsArr[activeYearIdx]; }
    function activeCount() { return yearCountsMap[activeYear()] || 1; }

    function activePanel() {
      return banner.querySelector('.rel-year-panel[data-year="' + activeYear() + '"]');
    }

    function activeTrack() {
      const panel = activePanel();
      return panel ? panel.querySelector('.rel-track') : null;
    }

    // ── build progress dot segments matching the active year's item count ─
    function buildDots() {
      const count = activeCount();
      progressEl.innerHTML = '';
      if (count <= 1) {
        progressEl.style.visibility = 'hidden';
        return;
      }
      progressEl.style.visibility = '';
      for (let i = 0; i < count; i++) {
        const seg  = document.createElement('div');
        seg.className = 'rel-seg';
        const fill = document.createElement('div');
        fill.className = 'rel-seg-fill';
        fill.dataset.seg = String(i);
        seg.appendChild(fill);
        progressEl.appendChild(seg);
      }
    }

    // ── render: push current state into the DOM ───────────────────────────
    function render() {
      // Translate the active year's track to the current slide
      const track = activeTrack();
      if (track) track.style.transform = 'translateX(-' + (slide * 100) + '%)';

      // Update year label in the selector button
      yearLbl.textContent = activeYear();

      // Sync dropdown option highlights + ARIA
      yearOpts.forEach(function(opt) {
        const isActive = opt.dataset.year === activeYear();
        opt.setAttribute('aria-selected', isActive ? 'true' : 'false');
        opt.classList.toggle('active', isActive);
      });

      // Animate progress fill segments
      const segs = Array.from(progressEl.querySelectorAll('.rel-seg-fill'));
      segs.forEach(function(seg, i) {
        if (reduced) {
          seg.style.animation = 'none';
          seg.style.width = i <= slide ? '100%' : '0%';
          return;
        }
        if (i < slide) {
          seg.style.animation = 'none';
          seg.style.width = '100%';
        } else if (i === slide) {
          seg.style.animation = 'none';
          void seg.offsetWidth; // force reflow to restart the animation
          seg.style.width = '';
          seg.style.animation = 'fillbar 6000ms linear forwards';
        } else {
          seg.style.animation = 'none';
          seg.style.width = '0%';
        }
      });
    }

    // ── switch active year (STRICT filter — resets slide to 0) ───────────
    function switchYear(idx) {
      // Hide the current year's panel
      const oldPanel = activePanel();
      if (oldPanel) oldPanel.style.display = 'none';

      activeYearIdx = idx;
      slide = 0;

      // Show the new year's panel
      const newPanel = activePanel();
      if (newPanel) newPanel.style.display = '';

      buildDots();
      render();
      startAutoplay();
    }

    // ── autoplay (within the active year only) ────────────────────────────
    function startAutoplay() {
      if (reduced) return;
      if (activeCount() <= 1) return; // single-item year — no autoplay
      stopAutoplay();
      timer = window.setInterval(function() {
        slide = (slide + 1) % activeCount();
        render();
      }, 6000);
    }

    function stopAutoplay() {
      if (timer !== null) { window.clearInterval(timer); timer = null; }
    }

    // Pause on banner hover; resume on leave
    banner.addEventListener('mouseenter', stopAutoplay);
    banner.addEventListener('mouseleave', startAutoplay);

    // ── prev/next arrows (stay within active year) ────────────────────────
    prevBtn && prevBtn.addEventListener('click', function() {
      const count = activeCount();
      slide = ((slide - 1) + count) % count;
      render();
      startAutoplay();
    });

    nextBtn && nextBtn.addEventListener('click', function() {
      slide = (slide + 1) % activeCount();
      render();
      startAutoplay();
    });

    // ── year dropdown ─────────────────────────────────────────────────────
    function openMenu() {
      yearMenu.classList.add('open');
      if (caretEl) caretEl.classList.add('open');
      yearBtn.setAttribute('aria-expanded', 'true');
      if (overlay) overlay.classList.add('active');
    }

    function closeMenu() {
      yearMenu.classList.remove('open');
      if (caretEl) caretEl.classList.remove('open');
      yearBtn.setAttribute('aria-expanded', 'false');
      if (overlay) overlay.classList.remove('active');
    }

    yearBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      yearMenu.classList.contains('open') ? closeMenu() : openMenu();
    });

    yearOpts.forEach(function(opt) {
      opt.addEventListener('click', function() {
        const yr  = opt.dataset.year || '';
        const idx = yearsArr.indexOf(yr);
        if (idx !== -1) switchYear(idx);
        closeMenu();
      });
    });

    if (overlay) overlay.addEventListener('click', closeMenu);

    // ── initial paint ─────────────────────────────────────────────────────
    buildDots();
    render();
    startAutoplay();
  }
</script>

<style>
  /* ── Section wrapper ── */
  .releases-section {
    position: relative;
    z-index: 2;
    padding: 120px 0;
    scroll-margin-top: 70px;
  }

  /* ── Inner container (max-width + gutter) ── */
  .rel-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ── Header row ── */
  .rel-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 40px;
  }

  .rel-header-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-text);
  }

  /* ── Year selector button ── */
  .rel-year-wrap {
    position: relative;
  }

  .rel-year-btn {
    all: unset;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    line-height: 1;
  }

  .rel-year-label {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(30px, 3.8vw, 50px);
    color: var(--color-accent);
    line-height: 1;
  }

  .rel-caret {
    font-style: normal;
    font-size: clamp(16px, 2vw, 26px);
    color: var(--color-text-dim);
    display: inline-block;
    transition: transform 0.28s ease;
    line-height: 1;
    margin-top: 0.1em;
  }

  .rel-caret.open {
    transform: rotate(180deg);
  }

  /* ── Year dropdown ── */
  .rel-year-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 20;
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    border-radius: 9px;
    padding: 8px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
    min-width: 110px;
  }

  .rel-year-menu.open {
    display: block;
  }

  .rel-year-opt {
    all: unset;
    display: block;
    width: 100%;
    box-sizing: border-box;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 23px;
    padding: 7px 18px;
    border-radius: 5px;
    color: var(--color-text);
    font-weight: 500;
    transition: background 0.15s;
  }

  .rel-year-opt:hover {
    background: var(--color-accent-tint);
  }

  .rel-year-opt.active {
    color: var(--color-accent);
    font-weight: 700;
  }

  /* ── Overlay (closes dropdown on outside click) ── */
  .rel-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9;
  }

  .rel-overlay.active {
    display: block;
  }

  /* ── Hero banner ── */
  .rel-banner {
    position: relative;
    border-radius: 5px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    margin-bottom: 58px;
  }

  /* ── Year panel wrapper (one per year; only the active one is visible) ── */
  .rel-year-panel {
    width: 100%;
    overflow: hidden;
  }

  /* ── Slide track (horizontal flex strip inside each year panel) ── */
  .rel-track {
    display: flex;
    width: 100%;
    transition: transform 0.6s cubic-bezier(0.16, 0.7, 0.2, 1);
  }

  /* ── Individual slide ── */
  .rel-slide {
    flex: 0 0 100%;
    min-height: clamp(330px, 42vw, 470px);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* Background image — absolutely fills the slide */
  .rel-slide-img {
    position: absolute !important;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    display: block;
  }

  /* Left-to-right dark gradient overlay (photo slides only) */
  .rel-slide-grad {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.36) 50%,
      rgba(0, 0, 0, 0) 82%
    );
    z-index: 1;
  }

  /* ── Themed striped placeholder tile (no-photo releases) ── */
  .rel-slide-placeholder {
    position: absolute;
    inset: 0;
    /* Diagonal stripe: --rel-a / --rel-b from global.css (themed) */
    background:
      radial-gradient(ellipse at 30% 50%, rgba(243, 169, 189, 0.07) 0%, transparent 62%),
      repeating-linear-gradient(
        135deg,
        var(--rel-a) 0px,
        var(--rel-a) 15px,
        var(--rel-b) 15px,
        var(--rel-b) 30px
      );
    z-index: 0;
  }

  /* Small brand-pink dot accent — top-left corner of placeholder */
  .rel-slide-placeholder-dot {
    position: absolute;
    top: clamp(20px, 3vw, 28px);
    left: clamp(20px, 3vw, 28px);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.75;
  }

  /* ── Content block (shared by photo + placeholder slides) ── */
  .rel-slide-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 5vw, 60px);
    /* Bottom padding clears the progress-bar + arrows row */
    padding-bottom: calc(clamp(34px, 4vw, 52px) + clamp(28px, 5vw, 48px) + 28px);
    max-width: 600px;
  }

  /* Eyebrow — photo slides use hardcoded #f3a9bd (identical to --color-accent) */
  .rel-slide-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #f3a9bd;
    margin-bottom: 12px;
  }

  /* Title — photo slides: white; placeholder slides: themed via modifier below */
  .rel-slide-title {
    font-family: var(--font-serif);
    font-size: clamp(36px, 6vw, 76px);
    font-weight: 400;
    line-height: 0.98;
    color: #fff;
    margin: 0 0 16px;
    /* Long single words (e.g. «Безнаказанным») must wrap, not overflow the
       flex column and slide under the cover square. */
    overflow-wrap: break-word;
    word-break: break-word;
    hyphens: auto;
  }

  .rel-slide-desc {
    font-size: 15px;
    line-height: 1.55;
    color: #d8d4cf;
    max-width: 400px;
    margin: 0 0 24px;
  }

  .rel-slide-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .rel-slide-cta {
    display: inline-block;
    background: #f3a9bd;
    color: #000;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    padding: 14px 28px;
    border-radius: 2px;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .rel-slide-cta:hover {
    background: #ffc0d0;
  }

  .rel-slide-meta {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.5px;
    color: #cfcbc6;
  }

  /* ── Placeholder content modifier — theme-aware colors ──
     Overrides the hardcoded white values so the tile reads correctly
     in both night (dark stripes) and day (warm cream stripes).       */
  .rel-slide-content--placeholder .rel-slide-title {
    color: var(--rel-fg);       /* night: #efe9e0 (off-white); day: #6a5a48 (dark brown) */
  }

  .rel-slide-content--placeholder .rel-slide-desc {
    color: var(--color-text-muted);
  }

  .rel-slide-content--placeholder .rel-slide-meta {
    color: var(--color-text-dim);
  }

  /* ── Progress bars ── */
  .rel-progress {
    position: absolute;
    left: clamp(28px, 5vw, 60px);
    bottom: clamp(34px, 4vw, 52px);
    display: flex;
    gap: 6px;
    width: clamp(120px, 18vw, 190px);
    z-index: 3;
  }

  .rel-seg {
    flex: 1;
    height: 3px;
    background: rgba(255, 255, 255, 0.28);
    border-radius: 2px;
    overflow: hidden;
  }

  .rel-seg-fill {
    height: 100%;
    background: #fff;
    width: 0%;
  }

  /* Autoplay fill keyframe — triggered via JS on each slide change */
  @keyframes fillbar {
    from { width: 0% }
    to   { width: 100% }
  }

  /* ── Prev / next arrows ── */
  .rel-arrows {
    position: absolute;
    right: clamp(28px, 5vw, 60px);
    bottom: clamp(34px, 4vw, 52px);
    display: flex;
    gap: 12px;
    z-index: 3;
  }

  .rel-arrow-btn {
    all: unset;
    cursor: pointer;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .rel-arrow-btn:hover {
    background: #f3a9bd;
    color: #000;
    border-color: #f3a9bd;
  }

  /* ── COVER MODE ──────────────────────────────────────────────────────────
     Blurred background + dark overlay + sharp square + text row.
     The slide frame (.rel-slide) is unchanged; all cover elements are
     positioned/stretched within it, so arrows/dots/autoplay work normally.
  ── */

  /* Blurred decorative background (decorative: may scale/crop) */
  .rel-cover-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.12);
    filter: blur(34px) brightness(0.5);
    z-index: 0;
  }

  /* Dark gradient overlay — ensures text contrast over the blurred bg */
  .rel-cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.72) 0%,
      rgba(0, 0, 0, 0.5) 55%,
