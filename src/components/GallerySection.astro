---
/**
 * GallerySection.astro — «Между песнями» photo gallery
 *
 * Pixel-faithful port of index.html lines 228-241.
 * Data from getCollection('gallery') — the v1→v2 CMS seam (FND-05, D-07).
 *
 * Dynamic image loading approach (RESEARCH assumption resolved):
 *   - Use import.meta.glob with { eager: true } to load all gallery images at build time
 *   - Look up by photo.data.filename key — Astro processes them as ImageMetadata
 *   - This satisfies Astro <Image> strict typing (requires ImageMetadata, not raw paths)
 *
 * Lightbox: PhotoSwipe 5 (GAL-01..03). Anchor-wrapped grid initialized via bundled <script>.
 *   - Standard <script> block (NOT is:inline) so Vite bundles photoswipe/style.css correctly.
 *   - Each gallery item is an <a> with data-pswp-width/height from full-res ImageMetadata.
 *   - Optional D-18 caption wired via data-pswp-caption + hidden span + uiRegister.
 * Mobile: .gallery-grid → 1fr 1fr; first item grid-row auto (global.css handles this).
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const photos = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);

// Eagerly import all gallery images so Astro can process them as ImageMetadata
// The glob key is the import path relative to this file
const galleryImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/*.jpg',
  { eager: true }
);
---

<section class="gallery-section">
  <div data-reveal class="gallery-intro">
    <div class="gallery-eyebrow">кадры</div>
    <h2 class="gallery-title">Между <span class="gallery-accent">песнями</span></h2>
  </div>

  <div id="gallery-grid" class="gallery-grid" data-reveal>
    {photos.map((photo) => {
      const imgPath = `../assets/images/${photo.data.filename}`;
      const imgModule = galleryImages[imgPath];
      const imgSrc = imgModule?.default;
      return (
        <a
          href={imgSrc?.src ?? '#'}
          data-pswp-width={imgSrc?.width}
          data-pswp-height={imgSrc?.height}
          data-pswp-caption={photo.data.caption}
          class={`gallery-item${photo.data.gridSpan === 'tall' ? ' gallery-item--tall' : ''}`}
        >
          {imgSrc && (
            <Image
              src={imgSrc}
              alt={photo.data.alt}
              widths={[400, 800]}
              sizes="(max-width: 860px) 50vw, 33vw"
              format="webp"
              quality={80}
              loading="lazy"
              class="gallery-img"
            />
          )}
          {photo.data.caption && (
            <span class="hidden-caption-content">{photo.data.caption}</span>
          )}
        </a>
      );
    })}
  </div>
</section>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '#gallery-grid',
    children: 'a',
    pswpModule: () => import('photoswipe'),
    arrowKeys: true,
    escKey: true,
  });

  lightbox.on('uiRegister', function () {
    lightbox.pswp?.ui?.registerElement({
      name: 'custom-caption',
      order: 9,
      isButton: false,
      appendTo: 'root',
      html: '',
      onInit: (el, pswp) => {
        pswp.on('change', () => {
          const curr = pswp.currSlide?.data.element;
          const caption = curr?.querySelector('.hidden-caption-content');
          const text = caption ? caption.innerHTML : '';
          el.innerHTML = text;
          // Hide the dark pill entirely when the photo has no caption (D-18)
          el.style.display = text ? 'block' : 'none';
        });
      },
    });
  });

  lightbox.init();
</script>

<style>
  .gallery-section {
    position: relative;
    z-index: 2;
    max-width: 1180px;
    margin: 0 auto;
    padding: 20px 40px 120px;
  }

  .gallery-intro {
    margin-bottom: 40px;
  }

  .gallery-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--color-accent-deep);
    margin-bottom: 16px;
  }

  .gallery-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(32px, 5vw, 62px);
    line-height: 1.02;
    margin: 0;
    letter-spacing: 0.3px;
    color: var(--color-text);
  }

  .gallery-accent {
    color: var(--color-accent-deep);
  }

  /* .gallery-grid: matching draft grid-template — 1.4fr 1fr 1fr / 210px 210px */
  .gallery-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    grid-template-rows: 210px 210px;
    gap: 12px;
  }

  /* .gallery-item base — hover transitions in global.css */
  .gallery-item {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    background: repeating-linear-gradient(
      45deg,
      var(--color-gallery-bg) 0 12px,
      var(--color-gallery-bg-alt) 12px 24px
    );
    text-decoration: none;
    display: block;
  }

  /* First item (gridSpan: 'tall') spans 2 rows — matches index.html style="grid-row:span 2" */
  .gallery-item--tall {
    grid-row: span 2;
  }

  .gallery-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Mobile: 2-column grid, no row spans (global.css also handles .gallery-grid) */
  @media (max-width: 860px) {
    .gallery-section {
      padding: 20px 20px 80px;
    }

    .gallery-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
    }

    .gallery-item--tall {
      grid-row: auto;
    }
  }
</style>

<style is:global>
  .pswp {
    --pswp-bg: var(--color-pswp-bg);
    --pswp-icon-color: var(--color-text);
    --pswp-icon-color-secondary: var(--color-text-subtle);
    --pswp-error-text-color: var(--color-accent);
  }

  .hidden-caption-content {
    display: none;
  }

  /* Caption: a high-contrast dark pill pinned to the bottom-center of the lightbox,
     so it's always easy to find and legible over ANY photo (user feedback fix). */
  .pswp__custom-caption {
    position: absolute;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    max-width: min(90vw, 640px);
    font-family: var(--font-sans);
    font-size: 14.5px;
    line-height: 1.35;
    color: var(--color-text);
    text-align: center;
    padding: 8px 18px;
    background: var(--color-overlay-scrim);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-radius: 999px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
    z-index: 10;
  }
</style>
