---
/**
 * ReleasesSection.astro — Releases hero slideshow
 *
 * Canonical design: claude_design_releases/_x/main.dc.html (lines 199–276, 614–642).
 * 3 featured slides (2026 / 2025 / 2024) with:
 *   - Year-selector dropdown (Prata italic, big pink year label + ▾ caret)
 *   - Full-bleed hero banner with photo + left-to-right gradient + content block
 *   - 3-segment progress bars (fillbar animation, 6 s/slide)
 *   - Prev/next arrows (photo-overlay style)
 *   - Autoplay (6 s), pause on hover, restart on manual nav
 *   - prefers-reduced-motion safe (no autoplay, no fill animation)
 *
 * Section id="music" so Nav «релизы» → #music anchor still works.
 * TracksSection (singles list) renders directly below in index.astro — do NOT touch.
 */
import { Image } from 'astro:assets';
import { releaseSlides } from '../data/releases.ts';
---

<section id="music" class="releases-section">
  <div class="rel-container">

    <!-- ── Header: eyebrow label + year selector ── -->
    <div data-reveal class="rel-header">
      <span class="rel-header-eyebrow">релизы</span>

      <div class="rel-year-wrap">
        <button
          id="rel-year-btn"
          class="rel-year-btn"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-label="Выбрать год"
        >
          <span id="rel-year-label" class="rel-year-label">2026</span>
          <span id="rel-caret" class="rel-caret" aria-hidden="true">▾</span>
        </button>

        <div id="rel-year-menu" class="rel-year-menu" role="listbox" aria-label="Год релиза">
          {releaseSlides.map((s, i) => (
            <button
              class={`rel-year-opt${i === 0 ? ' active' : ''}`}
              data-i={String(i)}
              role="option"
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              {s.year}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- ── Hero banner ── -->
    <div id="rel-banner" data-reveal class="rel-banner">

      <!-- Slide track -->
      <div id="rel-track" class="rel-track">
        {releaseSlides.map((s) => (
          <div class="rel-slide">
            <Image
              src={s.image}
              alt={`внимание брусника! — ${s.title}`}
              widths={[768, 1180]}
              sizes="(max-width: 860px) 100vw, 1180px"
              format="webp"
              quality={85}
              loading="lazy"
              class="rel-slide-img"
              style={`object-position: ${s.imagePosition}`}
            />
            <div class="rel-slide-grad" aria-hidden="true"></div>
            <div class="rel-slide-content">
              <span class="rel-slide-eyebrow">{s.eyebrow}</span>
              <h2 class="rel-slide-title">{s.title}</h2>
              <p class="rel-slide-desc">{s.desc}</p>
              <div class="rel-slide-actions">
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener"
                  class="rel-slide-cta"
                >{s.ctaLabel}</a>
                <span class="rel-slide-meta">{s.meta}</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Progress bars (3 segments) -->
      <div class="rel-progress" aria-hidden="true">
        {releaseSlides.map((_, i) => (
          <div class="rel-seg">
            <div class="rel-seg-fill" data-seg={String(i)}></div>
          </div>
        ))}
      </div>

      <!-- Prev / next arrows -->
      <div class="rel-arrows">
        <button id="rel-prev" class="rel-arrow-btn" aria-label="предыдущий релиз">←</button>
        <button id="rel-next" class="rel-arrow-btn" aria-label="следующий релиз">→</button>
      </div>

    </div><!-- /rel-banner -->
  </div><!-- /rel-container -->

  <!-- Full-screen invisible overlay: closes the year dropdown on outside click -->
  <div id="rel-overlay" class="rel-overlay" aria-hidden="true"></div>
</section>

<!-- ── Slideshow state machine ── -->
<script>
  const SLIDES = 3;
  const years  = ['2026', '2025', '2024'];

  // Element refs — guard every querySelector for SSR/null safety
  const track   = document.getElementById('rel-track')     as HTMLElement | null;
  const banner  = document.getElementById('rel-banner')    as HTMLElement | null;
  const yearBtn = document.getElementById('rel-year-btn')  as HTMLButtonElement | null;
  const yearLbl = document.getElementById('rel-year-label') as HTMLElement | null;
  const caretEl = document.getElementById('rel-caret')     as HTMLElement | null;
  const yearMenu= document.getElementById('rel-year-menu') as HTMLElement | null;
  const overlay = document.getElementById('rel-overlay')   as HTMLElement | null;
  const prevBtn = document.getElementById('rel-prev')      as HTMLButtonElement | null;
  const nextBtn = document.getElementById('rel-next')      as HTMLButtonElement | null;

  if (!track || !yearBtn || !yearLbl || !yearMenu) {
    // Component not present on this page — nothing to do
    // (guards against future conditional rendering)
  } else {
    const yearOpts = Array.from(yearMenu.querySelectorAll<HTMLElement>('.rel-year-opt'));
    const segs     = Array.from(document.querySelectorAll<HTMLElement>('.rel-seg-fill'));

    let current = 0;
    let timer: number | null = null;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── render: apply current state to DOM ──
    function render(): void {
      // Move slide track
      track!.style.transform = `translateX(-${current * 100}%)`;

      // Sync year label
      yearLbl!.textContent = years[current];

      // Sync dropdown option styling + ARIA
      yearOpts.forEach((opt, idx) => {
        const active = idx === current;
        opt.setAttribute('aria-selected', active ? 'true' : 'false');
        opt.classList.toggle('active', active);
      });

      // Sync progress segments
      segs.forEach((seg, idx) => {
        if (reduced) {
          seg.style.animation = 'none';
          seg.style.width = idx <= current ? '100%' : '0%';
          return;
        }
        if (idx < current) {
          // Already past — fill fully
          seg.style.animation = 'none';
          seg.style.width = '100%';
        } else if (idx === current) {
          // Active — restart fill animation
          seg.style.animation = 'none';
          void seg.offsetWidth; // force reflow to retrigger
          seg.style.width = '';
          seg.style.animation = 'fillbar 6000ms linear forwards';
        } else {
          // Upcoming — empty
          seg.style.animation = 'none';
          seg.style.width = '0%';
        }
      });
    }

    // ── autoplay ──
    function startAutoplay(): void {
      if (reduced) return;
      stopAutoplay();
      timer = window.setInterval(() => {
        current = (current + 1) % SLIDES;
        render();
      }, 6000);
    }

    function stopAutoplay(): void {
      if (timer !== null) { window.clearInterval(timer); timer = null; }
    }

    // Pause on banner hover; resume on leave
    banner?.addEventListener('mouseenter', stopAutoplay);
    banner?.addEventListener('mouseleave', startAutoplay);

    // ── arrows ──
    prevBtn?.addEventListener('click', () => {
      current = ((current - 1) + SLIDES) % SLIDES;
      render();
      startAutoplay();
    });

    nextBtn?.addEventListener('click', () => {
      current = (current + 1) % SLIDES;
      render();
      startAutoplay();
    });

    // ── year dropdown ──
    function openMenu(): void {
      yearMenu!.classList.add('open');
      caretEl?.classList.add('open');
      yearBtn!.setAttribute('aria-expanded', 'true');
      overlay?.classList.add('active');
    }

    function closeMenu(): void {
      yearMenu!.classList.remove('open');
      caretEl?.classList.remove('open');
      yearBtn!.setAttribute('aria-expanded', 'false');
      overlay?.classList.remove('active');
    }

    yearBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      yearMenu!.classList.contains('open') ? closeMenu() : openMenu();
    });

    yearOpts.forEach((opt) => {
      opt.addEventListener('click', () => {
        const idx = parseInt(opt.dataset.i ?? '0', 10);
        if (!isNaN(idx) && idx >= 0 && idx < SLIDES) {
          current = idx;
        }
        closeMenu();
        render();
        startAutoplay();
      });
    });

    overlay?.addEventListener('click', closeMenu);

    // ── initial paint ──
    render();
    startAutoplay();
  }
</script>

<style>
  /* ── Section wrapper ── */
  .releases-section {
    position: relative;
    z-index: 2;
    padding: 120px 0;
    scroll-margin-top: 70px;
  }

  /* ── Inner container (max-width + gutter) ── */
  .rel-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ── Header row ── */
  .rel-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 40px;
  }

  .rel-header-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-text);
  }

  /* ── Year selector button ── */
  .rel-year-wrap {
    position: relative;
  }

  .rel-year-btn {
    all: unset;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    line-height: 1;
  }

  .rel-year-label {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(30px, 3.8vw, 50px);
    color: var(--color-accent);
    line-height: 1;
  }

  .rel-caret {
    font-style: normal;
    font-size: clamp(16px, 2vw, 26px);
    color: var(--color-text-dim);
    display: inline-block;
    transition: transform 0.28s ease;
    line-height: 1;
    margin-top: 0.1em;
  }

  .rel-caret.open {
    transform: rotate(180deg);
  }

  /* ── Year dropdown ── */
  .rel-year-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 20;
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    border-radius: 9px;
    padding: 8px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
    min-width: 110px;
  }

  .rel-year-menu.open {
    display: block;
  }

  .rel-year-opt {
    all: unset;
    display: block;
    width: 100%;
    box-sizing: border-box;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 23px;
    padding: 7px 18px;
    border-radius: 5px;
    color: var(--color-text);
    font-weight: 500;
    transition: background 0.15s;
  }

  .rel-year-opt:hover {
    background: var(--color-accent-tint);
  }

  .rel-year-opt.active {
    color: var(--color-accent);
    font-weight: 700;
  }

  /* ── Overlay (closes dropdown on outside click) ── */
  .rel-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9;
  }

  .rel-overlay.active {
    display: block;
  }

  /* ── Hero banner ── */
  .rel-banner {
    position: relative;
    border-radius: 5px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    margin-bottom: 58px;
  }

  /* ── Slide track ── */
  .rel-track {
    display: flex;
    width: 100%;
    transition: transform 0.6s cubic-bezier(0.16, 0.7, 0.2, 1);
  }

  /* ── Individual slide ── */
  .rel-slide {
    flex: 0 0 100%;
    min-height: clamp(330px, 42vw, 470px);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* Background image — absolutely fills the slide */
  .rel-slide-img {
    position: absolute !important;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    display: block;
  }

  /* Left-to-right dark gradient overlay */
  .rel-slide-grad {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.36) 50%,
      rgba(0, 0, 0, 0) 82%
    );
    z-index: 1;
  }

  /* Content block — left side of slide, above gradient */
  .rel-slide-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 5vw, 60px);
    /* Bottom padding clears the progress-bar + arrows row */
    padding-bottom: calc(clamp(34px, 4vw, 52px) + clamp(28px, 5vw, 48px) + 28px);
    max-width: 600px;
  }

  .rel-slide-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #f3a9bd;
    margin-bottom: 12px;
  }

  .rel-slide-title {
    font-family: var(--font-serif);
    font-size: clamp(36px, 6vw, 76px);
    font-weight: 400;
    line-height: 0.98;
    color: #fff;
    margin: 0 0 16px;
  }

  .rel-slide-desc {
    font-size: 15px;
    line-height: 1.55;
    color: #d8d4cf;
    max-width: 400px;
    margin: 0 0 24px;
  }

  .rel-slide-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .rel-slide-cta {
    display: inline-block;
    background: #f3a9bd;
    color: #000;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    padding: 14px 28px;
    border-radius: 2px;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .rel-slide-cta:hover {
    background: #ffc0d0;
  }

  .rel-slide-meta {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.5px;
    color: #cfcbc6;
  }

  /* ── Progress bars ── */
  .rel-progress {
    position: absolute;
    left: clamp(28px, 5vw, 60px);
    bottom: clamp(34px, 4vw, 52px);
    display: flex;
    gap: 6px;
    width: clamp(120px, 18vw, 190px);
    z-index: 3;
  }

  .rel-seg {
    flex: 1;
    height: 3px;
    background: rgba(255, 255, 255, 0.28);
    border-radius: 2px;
    overflow: hidden;
  }

  .rel-seg-fill {
    height: 100%;
    background: #fff;
    width: 0%;
  }

  /* Autoplay fill keyframe — triggered via JS on each slide change */
  @keyframes fillbar {
    from { width: 0% }
    to   { width: 100% }
  }

  /* ── Prev / next arrows ── */
  .rel-arrows {
    position: absolute;
    right: clamp(28px, 5vw, 60px);
    bottom: clamp(34px, 4vw, 52px);
    display: flex;
    gap: 12px;
    z-index: 3;
  }

  .rel-arrow-btn {
    all: unset;
    cursor: pointer;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .rel-arrow-btn:hover {
    background: #f3a9bd;
    color: #000;
    border-color: #f3a9bd;
  }

  /* ── Mobile ── */
  @media (max-width: 860px) {
    .releases-section {
      padding: 80px 0;
    }

    .rel-container {
      padding: 0 20px;
    }

    .rel-header {
      margin-bottom: 28px;
    }

    .rel-banner {
      margin-bottom: 40px;
    }

    /* Scale down the slide description on narrow viewports */
    .rel-slide-desc {
      font-size: 14px;
    }

    /* On very small screens (< 480px) hide description to keep banner tidy */
    @media (max-width: 480px) {
      .rel-slide-desc {
        display: none;
      }
      .rel-slide-actions {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
      }
    }
  }
</style>
