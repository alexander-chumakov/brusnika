---
/**
 * Nav.astro — Fixed top navigation bar + full-screen mobile menu
 *
 * Mirrors the authoritative Claude Design mobile handoff:
 * - Top bar: logo + (desktop) links + ALWAYS-visible eye theme-toggle (between
 *   «концерты» and the pill, design position) + (desktop) «пойте с нами» pill +
 *   (mobile) burger.
 * - ≤860px: links + pill hide (.nav-desktop), burger shows (.nav-mobileonly),
 *   the eye stays in the bar. Burger opens a full-screen overlay menu with big
 *   Prata links (staggered fade-in), a footer eye toggle + «сменить тему» label,
 *   and social links.
 * - Two eye instances (top bar + overlay footer); both carry data-theme-toggle —
 *   the handler in Layout.astro wires all of them. Overlay open/close JS also
 *   lives in Layout.astro.
 */
import eyeDark from '../assets/eye-open-dark.jpg';
import eyeLight from '../assets/eye-open-light.jpg';
import eyeClosed from '../assets/eye-closed.jpg';
import { socialLinks } from '../data/site.ts';

const menuSocial = socialLinks.filter((l) => !l.url.startsWith('mailto'));
---

<nav>
  <a href="#top" class="nav-logo">
    <span class="nav-dot"></span>
    <span class="nav-wordmark">внимание брусника!</span>
  </a>

  <div class="nav-right">
    <a href="#music" class="nav-link nav-desktop">релизы</a>
    <a href="#clips" class="nav-link nav-desktop">клипы</a>
    <a href="#about" class="nav-link nav-desktop">о группе</a>
    <a href="#shows" class="nav-link nav-desktop">концерты</a>

    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      title="Сменить тему: день / ночь"
      aria-label="сменить тему: день или ночь"
      aria-pressed="false"
    >
      <span class="vb-eye">
        <img class="eye-dark" src={eyeDark.src} alt="глаз" width="48" height="48" loading="eager" decoding="async" />
        <img class="eye-light" src={eyeLight.src} alt="" width="48" height="48" loading="eager" decoding="async" />
        <img class="eye-closed" src={eyeClosed.src} alt="" width="48" height="48" loading="eager" decoding="async" />
      </span>
    </button>

    <a href="#sing" class="nav-pill nav-desktop" data-open-lessons>пойте с нами</a>

    <button
      type="button"
      class="nav-burger nav-mobileonly"
      data-nav-burger
      aria-expanded="false"
      aria-controls="nav-overlay"
      aria-label="открыть меню"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- Full-screen mobile menu overlay -->
<div class="nav-overlay" id="nav-overlay" data-nav-overlay aria-hidden="true">
  <div class="nav-overlay-glow" aria-hidden="true"></div>

  <div class="nav-overlay-head">
    <span class="nav-overlay-brand">
      <span class="nav-dot"></span>
      <span class="nav-overlay-wordmark">внимание брусника!</span>
    </span>
    <button type="button" class="nav-overlay-close" data-nav-close aria-label="закрыть меню">×</button>
  </div>

  <nav class="nav-overlay-nav">
    <a href="#music" class="nav-overlay-link">релизы</a>
    <a href="#clips" class="nav-overlay-link">клипы</a>
    <a href="#about" class="nav-overlay-link">о группе</a>
    <a href="#shows" class="nav-overlay-link">концерты</a>
    <a href="#sing" class="nav-overlay-link nav-overlay-link--cta" data-open-lessons>пойте с нами →</a>
  </nav>

  <div class="nav-overlay-foot">
    <div class="nav-overlay-theme">
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        title="Сменить тему: день / ночь"
        aria-label="сменить тему: день или ночь"
        aria-pressed="false"
      >
        <span class="vb-eye">
          <img class="eye-dark" src={eyeDark.src} alt="глаз" width="44" height="44" loading="eager" decoding="async" />
          <img class="eye-light" src={eyeLight.src} alt="" width="44" height="44" loading="eager" decoding="async" />
          <img class="eye-closed" src={eyeClosed.src} alt="" width="44" height="44" loading="eager" decoding="async" />
        </span>
      </button>
      <span class="nav-overlay-theme-label">сменить тему</span>
    </div>
    <div class="nav-overlay-social">
      {menuSocial.map((l) => (
        <a href={l.url} class="nav-overlay-social-link" target="_blank" rel="noopener noreferrer">{l.label}</a>
      ))}
    </div>
  </div>
</div>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 40px;
    backdrop-filter: blur(16px);
    background: var(--color-surface-nav);
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background 0.4s ease;
  }

  .nav-logo {
    text-decoration: none;
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .nav-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-accent);
    display: inline-block;
    box-shadow: 0 0 12px rgba(243, 169, 189, 0.9);
    flex-shrink: 0;
  }

  .nav-wordmark {
    font-family: var(--font-serif);
    font-size: 18px;
    letter-spacing: 0.5px;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .nav-link {
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 0.3px;
  }

  /* Day/night eye toggle — .vb-eye visual lives in global.css */
  .theme-toggle {
    all: unset;
    cursor: pointer;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  .theme-toggle:hover {
    opacity: 0.92;
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .nav-pill {
    text-decoration: none;
    color: var(--color-text-on-accent);
    background: var(--color-accent);
    font-size: 13.5px;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: 2px;
    letter-spacing: 0.3px;
    transition: background 0.25s;
  }

  .nav-pill:hover {
    background: var(--color-accent-hover);
  }

  /* Burger (mobile only) */
  .nav-burger {
    all: unset;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .nav-burger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .nav-burger span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--color-text);
  }

  .nav-burger span:nth-child(1),
  .nav-burger span:nth-child(2) { width: 26px; }
  .nav-burger span:nth-child(3) { width: 17px; }

  /* ---- Full-screen overlay menu ---- */
  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.32s ease, visibility 0.32s;
  }

  .nav-overlay.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .nav-overlay-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(85% 42% at 50% 0%, rgba(243, 169, 189, 0.13), transparent 62%);
  }

  .nav-overlay-head {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px;
    border-bottom: 1px solid var(--color-border);
  }

  .nav-overlay-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-overlay-wordmark {
    font-family: var(--font-serif);
    font-size: 17px;
    letter-spacing: 0.5px;
    color: var(--color-text);
  }

  .nav-overlay-close {
    all: unset;
    cursor: pointer;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    font-size: 30px;
    line-height: 1;
  }

  .nav-overlay-nav {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 0 30px;
  }

  .nav-overlay-link {
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: clamp(34px, 11vw, 52px);
    line-height: 1.18;
    color: var(--color-text);
    opacity: 0;
  }

  .nav-overlay-link--cta {
    font-style: italic;
    color: var(--color-accent-deep);
  }

  .nav-overlay-foot {
    position: relative;
    padding: 22px 30px 38px;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    opacity: 0;
  }

  .nav-overlay-theme {
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .nav-overlay-theme .theme-toggle {
    width: 46px;
    height: 46px;
  }

  .nav-overlay-theme .vb-eye {
    width: 44px;
    height: 44px;
  }

  .nav-overlay-theme-label {
    font-size: 13px;
    color: var(--color-text-dim);
    letter-spacing: 0.3px;
  }

  .nav-overlay-social {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .nav-overlay-social-link {
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 14px;
    transition: color 0.2s ease;
  }

  .nav-overlay-social-link:hover {
    color: var(--color-text);
  }

  /* Staggered entrance — only when the overlay is open */
  .nav-overlay.open .nav-overlay-link,
  .nav-overlay.open .nav-overlay-foot {
    animation: menuItem 0.55s cubic-bezier(.16, .7, .2, 1) both;
  }
  .nav-overlay.open .nav-overlay-link:nth-child(1) { animation-delay: .06s; }
  .nav-overlay.open .nav-overlay-link:nth-child(2) { animation-delay: .11s; }
  .nav-overlay.open .nav-overlay-link:nth-child(3) { animation-delay: .16s; }
  .nav-overlay.open .nav-overlay-link:nth-child(4) { animation-delay: .21s; }
  .nav-overlay.open .nav-overlay-link:nth-child(5) { animation-delay: .27s; }
  .nav-overlay.open .nav-overlay-foot { animation-delay: .34s; }

  @keyframes menuItem {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-overlay.open .nav-overlay-link,
    .nav-overlay.open .nav-overlay-foot {
      animation: none;
      opacity: 1;
    }
  }

  /* Breakpoint: desktop links/pill hide, burger shows. Eye stays. */
  @media (max-width: 860px) {
    nav {
      padding: 14px 22px;
    }

    .nav-desktop {
      display: none !important;
    }

    .nav-burger {
      display: flex;
    }
  }

  /* The overlay is mobile-only — never render it past the breakpoint. */
  @media (min-width: 861px) {
    .nav-overlay {
      display: none !important;
    }
  }
</style>
