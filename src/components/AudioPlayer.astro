<!--
  FEATURE: brusnika snowfall — MUST be global. Berry <img> nodes are created
  with document.createElement and appended to document.body, so they never
  receive Astro's component scope hash. Scoped selectors would not match →
  invisible. This block is :global so the JS-created nodes are styled/animated.
-->
<style is:global>
  .bloom-layer {
    position: fixed;
    inset: 0;
    /* Above the now-playing bar (z 60) so berries visibly SETTLE on top of it
       and fade there; pointer-events:none keeps the bar fully clickable. */
    z-index: 61;
    pointer-events: none;
    overflow: hidden;
  }

  /* Each particle is the real brand berry SVG (public/favicon.svg). The motion
     is driven by the Web Animations API in JS (element.animate), NOT CSS
     keyframes — so the staggered fall and a SHARED, synchronized fade-start
     (1.5s after the LAST berry lands) can be computed per berry. This base rule
     only positions/sizes the node and keeps it invisible (opacity 0) until the
     WAAPI animation's backwards-fill applies its first keyframe (also off-screen
     + opacity 0). It can therefore never flash on the player before it falls.
     `left`, `width`, `height` are set inline per berry in JS. */
  .bloom-berry {
    position: absolute;
    top: 0;
    opacity: 0;
    will-change: transform, opacity;
    transform-origin: center;
  }

  /* Accessibility belt-and-braces: even if a node slips through, no motion */
  @media (prefers-reduced-motion: reduce) {
    .bloom-layer {
      display: none;
    }
  }
</style>
