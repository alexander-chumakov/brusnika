---
/**
 * VideoSection.astro — «На экране» social-media clip section
 *
 * Reads the `videos` content collection (CDN-backed clips; 9 entries as of 02-04).
 * Renders every entry sorted by `order` — no fixed count assumed.
 * Clips are SOCIAL-MEDIA / Stories style: PORTRAIT 9:16 cards.
 * Renders a horizontal scroll-snap CAROUSEL on ALL viewports (desktop + mobile) —
 * pure CSS scroll-snap, no JS carousel library. Desktop adds optional ◂ ▸ scroll arrows.
 *
 * Interaction (YouTube-Shorts style):
 *   - The carousel shows PORTRAIT 9:16 poster cards with a 64px play button (C-02, VID-01).
 *     The cards themselves NEVER play video and NEVER autoplay (VID-02).
 *   - Clicking a card (poster/play) opens a centered ENLARGE MODAL: a dimmed full-viewport
 *     backdrop with one tall portrait <video> centered on screen (height ~min(88vh,…) so
 *     desktop has clear dark side-margins — exactly like a YouTube Short). This is a
 *     CSS-positioned overlay, NOT the browser Fullscreen API (no requestFullscreen()).
 *   - The modal video plays on open (the click is the user gesture that permits playback);
 *     no autoplay occurs anywhere on the page itself (VID-02).
 *   - Close: × button, Esc key, or clicking the dimmed backdrop — each stops + resets
 *     playback and restores body scroll.
 *   - Works on desktop and mobile (on a phone the portrait video naturally fills the screen).
 *   - preload="none" so clips don't fetch on page load (T-02-09).
 *   - Phase 3 share hooks: data-clip-url + data-clip-title on each card, reserved 44×44px
 *     bottom-right slot .video-share-slot (D-16).
 *
 * client:visible — below the fold; Astro hydrates only when scrolled into view.
 */
import { getCollection } from 'astro:content';

const videos = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order);
---

<section id="clips" class="video-section">
  <div data-reveal class="video-intro">
    <div class="video-eyebrow">клипы</div>
    <h2 class="video-heading">Смотрите и делитесь <span class="video-accent">с друзьями</span></h2>
  </div>

  <div data-reveal class="video-carousel-wrap">
    <!-- Desktop scroll arrows (shown only on pointer:fine); carousel is swipeable everywhere -->
    <button class="video-arrow video-arrow-prev" aria-label="Предыдущие клипы" hidden>◂</button>

    <div class="video-carousel">
      {videos.map((v) => (
        <div
          class="video-card"
          data-clip-url={v.data.videoUrl}
          data-clip-title={v.data.title}
        >
          <!-- Portrait 9:16 media frame -->
          <div class="video-frame">
            <button class="video-poster-btn" aria-label={`Воспроизвести ${v.data.title}`}>
              <img
                class="video-poster"
                src={v.data.posterUrl}
                alt={v.data.title}
                loading="lazy"
              />
              <!-- Bottom gradient for readability of the title label -->
              <span class="video-gradient" aria-hidden="true"></span>
              <span class="video-play-btn" aria-hidden="true">▶</span>
              <span class="video-title-label">{v.data.title}</span>
            </button>

            <!-- Phase 3 share button — fills the reserved 44×44px slot (D-16, D-03) -->
            <div class="video-share-slot">
              <button
                class="video-share-btn"
                type="button"
                aria-label="Поделиться клипом"
                aria-haspopup="menu"
                aria-expanded="false"
              >
                <span class="video-share-glyph" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                </span>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <button class="video-arrow video-arrow-next" aria-label="Следующие клипы" hidden>▸</button>
  </div>

  <!-- Shorts-style enlarge modal — one shared overlay; src swapped on open.
       Centered portrait video on a dimmed backdrop; CSS overlay, NOT Fullscreen API. -->
  <div class="video-modal" data-open="false" hidden>
    <div class="video-modal-backdrop" data-modal-close></div>
    <!-- Close button is a SIBLING of the stage (not inside it) so it renders in the
         dimmed margin, never overlapping the video's native controls and never
         clipped by the stage's overflow:hidden. -->
    <button class="video-modal-close" aria-label="Закрыть">×</button>
    <!-- Share button kept OFF the video, in the dimmed margin just left of the close
         button. Native video controls occupy BOTH the top (PiP + volume in Safari/iOS)
         and the bottom (play/timeline), so no corner of the video is clear — the margin
         is the only collision-free spot. Sibling of the stage so it's not clipped by
         the stage's overflow:hidden. Reads the open clip's url/title, set on modal open. -->
    <button
      class="video-share-btn video-share-btn--modal"
      type="button"
      aria-label="Поделиться клипом"
      aria-haspopup="menu"
      aria-expanded="false"
    >
      <span class="video-share-glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
      </span>
    </button>
    <div class="video-modal-stage" role="dialog" aria-modal="true" aria-label="Просмотр клипа">
      <video
        class="video-modal-video"
        controls
        playsinline
        preload="none"
      ></video>
    </div>
  </div>

  <!-- Desktop share popover — ONE shared element, portaled to <body> at runtime so it
       escapes the carousel/card overflow:hidden. Opens only when navigator.share is
       absent (desktop). Inert when closed (visibility:hidden + pointer-events:none). -->
  <div class="share-popover" role="menu" data-open="false" aria-label="Поделиться">
    <button class="share-popover-item" type="button" role="menuitem" data-share="vk">
      <span class="share-popover-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.785 16.241s.288-.032.436-.194c.136-.148.131-.427.131-.427s-.018-1.304.586-1.496c.596-.189 1.36 1.26 2.171 1.818.613.422 1.079.33 1.079.33l2.164-.03s1.132-.07.595-.96c-.044-.073-.313-.661-1.612-1.869-1.36-1.264-1.176-1.059.46-3.246.997-1.331 1.396-2.143 1.271-2.491-.118-.331-.85-.244-.85-.244l-2.435.015s-.181-.025-.315.055c-.131.079-.215.262-.215.262s-.387 1.031-.902 1.907c-1.088 1.852-1.523 1.95-1.701 1.835-.413-.267-.31-1.073-.31-1.646 0-1.79.272-2.536-.529-2.729-.265-.064-.46-.106-1.139-.113-.871-.009-1.608.003-2.025.207-.278.136-.492.439-.361.457.161.022.525.099.718.362.249.34.24 1.105.24 1.105s.143 2.094-.334 2.355c-.327.179-.776-.186-1.746-1.866-.497-.86-.872-1.81-.872-1.81s-.072-.177-.201-.272c-.156-.115-.374-.151-.374-.151l-2.314.015s-.347.01-.474.161c-.114.135-.009.414-.009.414s1.813 4.243 3.867 6.38c1.883 1.96 4.021 1.832 4.021 1.832z"/></svg>
      </span>
      <span class="share-popover-label">Поделиться ВКонтакте</span>
    </button>
    <button class="share-popover-item" type="button" role="menuitem" data-share="telegram">
      <span class="share-popover-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.329-.913.489-1.302.481-.428-.009-1.252-.242-1.865-.44-.752-.244-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
      </span>
      <span class="share-popover-label">Поделиться в Telegram</span>
    </button>
    <button class="share-popover-item" type="button" role="menuitem" data-share="copy">
      <span class="share-popover-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      </span>
      <span class="share-popover-label">Скопировать ссылку</span>
    </button>
  </div>
</section>

<script>
  import { shareText, shareTitle } from '../data/site.ts';

  // ── Shorts-style enlarge modal ──────────────────────────────
  // Cards never play inline and never autoplay (VID-02). Clicking a card opens a
  // centered overlay (CSS-positioned, NOT requestFullscreen) and plays the CDN clip.
  const modal = document.querySelector<HTMLElement>('.video-modal');
  const modalVideo = modal?.querySelector<HTMLVideoElement>('.video-modal-video');
  const closeBtn = modal?.querySelector<HTMLButtonElement>('.video-modal-close');
  const backdrop = modal?.querySelector<HTMLElement>('[data-modal-close]');

  // Portal the modal to <body> so it escapes the VideoSection <section>'s low-z
  // stacking context. Inside the section, the modal's z-index only competes within
  // that context and paints BELOW the fixed site nav (z-index:50) — covering the
  // close button. As a direct child of <body> it competes at the ROOT stacking
  // context (z-index:2000) and sits above nav, the now-playing bar, and the lessons
  // modal. Astro's scoped data-astro attribute moves with the node, so styling is kept.
  // Children's event listeners move with the node too.
  if (modal && modal.parentElement !== document.body) {
    document.body.appendChild(modal);
  }

  // Cross-component coordinator (decoupled via DOM CustomEvent): whenever the modal
  // video starts playing — on open-autoplay OR a manual resume — announce it so the
  // AudioPlayer can pause the music (both must not play at once). Binding to the
  // element's own `play` event is more reliable than dispatching only on open.
  modalVideo?.addEventListener('play', () => {
    document.dispatchEvent(new CustomEvent('brusnika:video-play'));
  });

  // The clip currently shown in the enlarge modal — read by the modal's share button.
  let openClip: { url: string; title: string } | null = null;

  function openModal(url: string, title: string) {
    if (!modal || !modalVideo) return;
    openClip = { url, title };
    modalVideo.src = url;
    modalVideo.setAttribute('aria-label', title);
    modal.hidden = false;
    // force reflow so the open transition runs
    void modal.offsetWidth;
    modal.dataset.open = 'true';
    document.body.style.overflow = 'hidden'; // lock body scroll while open
    // The opening click is a user gesture, so playback is permitted here.
    modalVideo.play().catch(() => {
      // play() may reject if the browser still blocks — controls remain available
    });
  }

  function closeModal() {
    if (!modal || !modalVideo) return;
    // The share popover is portaled to <body>, so it outlives the modal unless we
    // close it explicitly — otherwise its options linger after the video is gone.
    closePopover(false);
    modal.dataset.open = 'false';
    modalVideo.pause();
    modalVideo.removeAttribute('src');
    modalVideo.load(); // reset playback state
    document.body.style.overflow = ''; // restore body scroll
    modal.hidden = true;
  }

  document.querySelectorAll<HTMLElement>('.video-card').forEach((card) => {
    const trigger = card.querySelector<HTMLButtonElement>('.video-poster-btn');
    const url = card.dataset.clipUrl;
    const title = card.dataset.clipTitle ?? '';
    if (!trigger || !url) return;

    trigger.addEventListener('click', () => openModal(url, title));
  });

  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    // If the popover is open, Escape closes it first (its own handler does that) —
    // leave the modal open this round.
    if (popover && popover.dataset.open === 'true') return;
    if (modal && modal.dataset.open === 'true') closeModal();
  });

  // Show a friendly error in the modal if the clip can't load.
  // The persistent close button is a sibling of the stage, so it keeps working —
  // we only swap the stage contents (don't inject another close button here).
  modalVideo?.addEventListener('error', () => {
    // Ignore the spurious error fired when we clear src on close.
    if (!modalVideo.getAttribute('src')) return;
    const stage = modal?.querySelector<HTMLElement>('.video-modal-stage');
    if (stage) {
      stage.innerHTML =
        '<p class="video-modal-error">Видео временно недоступно. Попробуйте обновить страницу.</p>';
    }
  });

  // ── Desktop scroll arrows (pointer:fine only) ───────────────
  document.querySelectorAll<HTMLElement>('.video-carousel-wrap').forEach((wrap) => {
    const carousel = wrap.querySelector<HTMLElement>('.video-carousel');
    const prev = wrap.querySelector<HTMLButtonElement>('.video-arrow-prev');
    const next = wrap.querySelector<HTMLButtonElement>('.video-arrow-next');
    if (!carousel || !prev || !next) return;

    const hasFinePointer = window.matchMedia('(pointer: fine)').matches;
    if (!hasFinePointer) return; // touch devices swipe directly; keep arrows hidden

    prev.hidden = false;
    next.hidden = false;

    function scrollByCard(dir: number) {
      if (!carousel) return;
      const firstCard = carousel.querySelector<HTMLElement>('.video-card');
      const step = firstCard ? firstCard.offsetWidth + 16 : carousel.clientWidth * 0.8;
      carousel.scrollBy({ left: dir * step, behavior: 'smooth' });
    }

    prev.addEventListener('click', () => scrollByCard(-1));
    next.addEventListener('click', () => scrollByCard(1));

    function updateArrows() {
      if (!carousel || !prev || !next) return;
      const maxScroll = carousel.scrollWidth - carousel.clientWidth;
      prev.classList.toggle('is-disabled', carousel.scrollLeft <= 2);
      next.classList.toggle('is-disabled', carousel.scrollLeft >= maxScroll - 2);
    }

    carousel.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    updateArrows();
  });

  // ── Share flow (SHARE-02 mobile file share / SHARE-03 desktop popover) ──────
  // Mobile: hand the actual clip .mp4 to the OS native share sheet (Web Share Level 2,
  // files-only per iOS caveat); degrade to link share when files unsupported.
  // Desktop (no navigator.share): open the VK / Telegram / Copy-link popover.
  const popover = document.querySelector<HTMLElement>('.share-popover');

  // Portal the popover to <body> (same pattern as the modal) so it escapes the
  // carousel/card overflow:hidden and competes at the root stacking context.
  if (popover && popover.parentElement !== document.body) {
    document.body.appendChild(popover);
  }

  // The button that opened the popover — focus returns here on close.
  let popoverTrigger: HTMLButtonElement | null = null;
  let copyTimer: ReturnType<typeof setTimeout> | null = null;
  // Guard against overlapping native-share invocations: a slow share sheet plus
  // repeated taps otherwise throws InvalidStateError and falls through to the
  // popover, producing duplicate/ghost popovers.
  let isSharing = false;

  function closePopover(returnFocus = true) {
    if (!popover) return;
    popover.dataset.open = 'false';
    const trigger = popoverTrigger;
    popoverTrigger = null;
    if (trigger) {
      trigger.setAttribute('aria-expanded', 'false');
      // Don't yank focus back to a trigger that's been hidden (e.g. the modal
      // share button when the video modal is closing).
      if (returnFocus && trigger.isConnected) {
        try {
          trigger.focus();
        } catch {
          /* not focusable (hidden) — ignore */
        }
      }
    }
  }

  function openPopover(trigger: HTMLButtonElement) {
    if (!popover) return;
    popoverTrigger = trigger;
    // Anchor the fixed popover above the button's right edge (escapes card overflow).
    const rect = trigger.getBoundingClientRect();
    // Make it measurable, then position with the real size.
    popover.style.left = '0px';
    popover.style.top = '0px';
    void popover.offsetWidth; // reflow so getBoundingClientRect is accurate
    const pw = popover.offsetWidth;
    const ph = popover.offsetHeight;
    let left = rect.right - pw;
    let top = rect.top - ph - 8; // 8px above the button
    if (top < 8) top = rect.bottom + 8; // flip below if no room above
    if (left < 8) left = 8;
    const maxLeft = window.innerWidth - pw - 8;
    if (left > maxLeft) left = Math.max(8, maxLeft);
    popover.style.left = `${left}px`;
    popover.style.top = `${top}px`;
    void popover.offsetWidth; // reflow before toggling open so the transition runs
    popover.dataset.open = 'true';
    trigger.setAttribute('aria-expanded', 'true');
  }

  async function shareClip(
    trigger: HTMLButtonElement,
    clipUrl: string,
    clipTitle: string,
  ) {
    const siteUrl = window.location.origin; // D-09 — home page, runtime only

    const canFileShare =
      typeof navigator.canShare === 'function' &&
      navigator.canShare({
        files: [new File([''], 'test.mp4', { type: 'video/mp4' })],
      });
    const hasShare = typeof navigator.share === 'function';

    // Native share (mobile/tablet). Guarded so a slow share sheet + repeated taps
    // can't stack navigator.share() calls (InvalidStateError) and spawn ghost popovers.
    if (canFileShare || hasShare) {
      if (isSharing) return; // a share sheet is already opening — ignore extra taps
      isSharing = true;
      try {
        // 1. File share (Web Share Level 2). canShare({files}) gated the fetch.
        if (canFileShare) {
          try {
            const res = await fetch(clipUrl);
            const blob = await res.blob();
            const file = new File([blob], `${clipTitle}.mp4`, { type: 'video/mp4' });
            // FILES ONLY — no title/text/url (iOS Safari suppresses the sheet otherwise).
            await navigator.share({ files: [file] });
            return;
          } catch (err) {
            if (err instanceof Error && err.name === 'AbortError') return; // cancelled
            // Any other error (e.g. CORS fetch failure) falls through to link share.
          }
        }

        // 2. Link share when files are unsupported but Web Share exists.
        if (hasShare) {
          try {
            await navigator.share({
              title: shareTitle(clipTitle),
              text: shareText,
              url: siteUrl,
            });
            return;
          } catch (err) {
            if (err instanceof Error && err.name === 'AbortError') return; // cancelled
            // Other errors surface no UI; fall through to the popover.
          }
        }
      } finally {
        isSharing = false;
      }
    }

    // 3. Desktop fallback — open the VK / Telegram / Copy-link popover.
    // The popover always shares the home-page URL (D-09), so it needs no clip ref.
    openPopover(trigger);
  }

  // Card share buttons read the clip from their .video-card; the modal button reads
  // the currently-open clip.
  document.querySelectorAll<HTMLButtonElement>('.video-share-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      // Toggle: a second tap on the same trigger closes the open popover.
      if (popover && popover.dataset.open === 'true' && popoverTrigger === btn) {
        closePopover();
        return;
      }
      const isModalBtn = btn.classList.contains('video-share-btn--modal');
      let url: string | undefined;
      let title = '';
      if (isModalBtn) {
        url = openClip?.url;
        title = openClip?.title ?? '';
      } else {
        const card = btn.closest<HTMLElement>('.video-card');
        url = card?.dataset.clipUrl;
        title = card?.dataset.clipTitle ?? '';
      }
      if (!url) return;
      void shareClip(btn, url, title);
    });
  });

  // ── Popover row actions ─────────────────────────────────────
  popover?.querySelectorAll<HTMLButtonElement>('.share-popover-item').forEach((item) => {
    item.addEventListener('click', async () => {
      const siteUrl = window.location.origin;
      const action = item.dataset.share;
      if (action === 'vk') {
        window.open(
          'https://vk.com/share.php?url=' + encodeURIComponent(siteUrl),
          '_blank',
          'noopener',
        );
        closePopover();
      } else if (action === 'telegram') {
        window.open(
          'https://t.me/share/url?url=' +
            encodeURIComponent(siteUrl) +
            '&text=' +
            encodeURIComponent(shareText),
          '_blank',
          'noopener',
        );
        closePopover();
      } else if (action === 'copy') {
        try {
          await navigator.clipboard.writeText(siteUrl);
        } catch {
          // Clipboard may be blocked; show no error UI (silent).
        }
        const label = item.querySelector<HTMLElement>('.share-popover-label');
        if (label) {
          const original = label.textContent ?? 'Скопировать ссылку';
          label.textContent = 'Скопировано ✓';
          item.classList.add('share-copied');
          if (copyTimer) clearTimeout(copyTimer);
          copyTimer = setTimeout(() => {
            label.textContent = original;
            item.classList.remove('share-copied');
          }, 2000);
        }
        // Copy keeps the popover open.
      }
    });
  });

  // Close popover on tap/click-outside and on Escape; return focus to the trigger.
  // pointerdown (not click) so it fires reliably on touch — mobile browsers often
  // don't dispatch `click` for taps on non-interactive areas (Huawei/iOS Safari).
  document.addEventListener('pointerdown', (e) => {
    if (!popover || popover.dataset.open !== 'true') return;
    const target = e.target as Node;
    if (popover.contains(target)) return;
    // The trigger handles its own toggle (and re-opens on click); ignore it here so
    // we don't close-then-reopen on the same tap.
    if (popoverTrigger && popoverTrigger.contains(target)) return;
    closePopover();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && popover && popover.dataset.open === 'true') {
      closePopover();
    }
  });
</script>

<style>
  /* ── Section container ───────────────────────────────────── */
  .video-section {
    position: relative;
    z-index: 2;
    max-width: 1180px;
    margin: 0 auto;
    padding: 130px 40px 110px;
    scroll-margin-top: 70px;
  }

  /* ── Intro block (eyebrow + heading) ────────────────────── */
  .video-intro {
    margin-bottom: 40px;
  }

  .video-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .video-heading {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(32px, 5vw, 62px);
    line-height: 1.02;
    margin: 0;
    letter-spacing: 0.3px;
    color: var(--color-text);
  }

  .video-accent {
    color: var(--color-accent);
  }

  /* ── Carousel wrapper (positions desktop arrows) ─────────── */
  .video-carousel-wrap {
    position: relative;
  }

  /* ── Carousel — horizontal scroll-snap on ALL viewports ──── */
  .video-carousel {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    padding: 4px 2px; /* snapped cards aren't flush to arrows */
  }

  .video-carousel::-webkit-scrollbar {
