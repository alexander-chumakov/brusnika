---
/**
 * index.astro — Home page
 *
 * Document order matches index.html exactly:
 *   Nav → Hero → Marquee → ReleasesSection (carousel)
 *   → [Plan 03: TracksSection, ShowsSection, GallerySection]
 *   → About → Sing
 *   → [Plan 04: Footer + BookingModal markup]
 *
 * Islands:
 *   AudioPlayer  client:idle    — real audio playback (02-02)
 *   VideoSection client:visible — below-fold clip carousel/grid (02-04)
 *
 * Prerendered by default (output: static in astro.config.mjs).
 */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import HeroSection from '../components/HeroSection.astro';
import MarqueeSection from '../components/MarqueeSection.astro';
import ReleasesSection from '../components/ReleasesSection.astro';
import TracksSection from '../components/TracksSection.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import VideoSection from '../components/VideoSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ShowsSection from '../components/ShowsSection.astro';
import GallerySection from '../components/GallerySection.astro';
import SingSection from '../components/SingSection.astro';
import FooterSection from '../components/FooterSection.astro';
---

<Layout>
  <Nav />
  <HeroSection />
  <MarqueeSection />
  <ReleasesSection />
  <TracksSection />
  <AudioPlayer client:idle />
  <VideoSection client:visible />

  <AboutSection />
  <ShowsSection />
  <GallerySection />
  <SingSection />

  <FooterSection />
  {/* Plan 04: LessonsModal added in Layout.astro */}
</Layout>

