---
/**
 * Layout.astro — HTML/head shell for внимание брусника!
 *
 * - Self-hosted fonts via @fontsource (no Google Fonts)
 * - Env-gated noindex meta tag (RESEARCH Pattern 4)
 * - Global CSS design tokens import
 * - Cursor-glow markup + JS activation (Plan 04: FND-03)
 * - .js-reveal inline head script (Plan 04: prevents flash-then-hide, 01-02 SUMMARY handoff)
 * - LessonsModal rendered at end of body (Plan 04: D-05)
 * - global-animations.js IIFE inlined (Plan 04: D-06)
 * - demo-modal.js IIFE inlined (Plan 04: D-05)
 *
 * See: RESEARCH.md Pattern 6 (font self-hosting), Pattern 4 (noindex)
 */

// Self-hosted fonts — import CSS files so Astro bundles woff2 files
// NO <link> to fonts.googleapis.com or fonts.gstatic.com (FND-02)
// Using explicit .css paths avoids TypeScript side-effect import error
import '@fontsource/prata/400.css';    // weight 400; includes Cyrillic subset
import '@fontsource/golos-text/400.css';
import '@fontsource/golos-text/500.css';
import '@fontsource/golos-text/600.css';
import '@fontsource/golos-text/700.css';

// Global design tokens, resets, keyframes, interactive states
import '../styles/global.css';

// Lessons modal (D-05 throwaway demo; Phase 3 replaces submit handler)
import LessonsModal from '../components/LessonsModal.astro';

// Env-gated noindex (read at build time — static pages bake this into HTML)
const noindex = import.meta.env.NOINDEX === 'true';
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>внимание брусника! — dream-pop</title>
    <meta
      name="description"
      content="внимание брусника! — камерный dream-pop проект. Негромкие песни о любви и о том, что трудно сказать вслух."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=2" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!--
      No-flash theme init (Phase 03.1, D-05). Render-blocking, runs BEFORE
      first paint so the correct theme is applied with no flash:
        (1) restore the saved choice from localStorage['vb-theme'], else
        (2) follow the device prefers-color-scheme on first visit.
      Night is the default (no data-theme attribute); day sets data-theme="day".
    -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('vb-theme');
          if (saved === 'day') {
            document.documentElement.setAttribute('data-theme', 'day');
          } else if (!saved && window.matchMedia &&
                     window.matchMedia('(prefers-color-scheme: light)').matches) {
            document.documentElement.setAttribute('data-theme', 'day');
          }
          // night = default (no attribute)
        } catch (e) {}
      })();
    </script>

    <!--
      .js-reveal inline render-blocking script (01-02 SUMMARY handoff, Plan 04)
      MUST run BEFORE first paint to avoid flash-then-hide of content:
        (1) Mark document root with .js-reveal so global.css hides [data-reveal] elements
        (2) Respect prefers-reduced-motion: if reduced motion preferred, skip — content stays visible
      This script is render-blocking by design (no defer/async/module) so the class is set
      before any [data-reveal] content is painted.
    -->
    <script is:inline>
      (function () {
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          // Reduced motion: skip .js-reveal entirely — content remains visible, no animation
          return;
        }
        document.documentElement.classList.add('js-reveal');
      })();
    </script>
  </head>
  <body>
    <!-- Root wrapper — matches index.html line 58 exactly -->
    <div style="position:relative;overflow-x:hidden;background:var(--color-bg);">
      <!-- Cursor-follow glow (FND-03; activated by global-animations.js inline script below) -->
      <div
        id="cursor-glow"
        style="position:fixed;top:0;left:0;width:520px;height:520px;margin:-260px 0 0 -260px;border-radius:50%;pointer-events:none;z-index:1;background:radial-gradient(circle, var(--color-glow-cursor), transparent 62%);transition:transform .35s cubic-bezier(.2,.7,.2,1);will-change:transform;"
      ></div>
      <div
        style="position:fixed;inset:0;pointer-events:none;z-index:1;background:radial-gradient(70% 45% at 50% -8%, var(--color-glow-radial), transparent 60%);"
      ></div>

      <!-- Page content from child components -->
      <slot />

      <!-- Lessons modal (D-05 throwaway demo; Phase 3 replaces submit handler with fetch('/api/book')) -->
      <LessonsModal />
    </div>

    <!--
      global-animations.js — Scroll-reveal (IntersectionObserver) + cursor-glow (FND-03, D-06)
      is:inline on <script> BLOCK inlines content verbatim (A2 resolved in Plan 03 SUMMARY).
      Source file: src/scripts/global-animations.js
    -->
    <script is:inline>
      (function globalAnimations() {
        // Scroll reveal — IntersectionObserver adds .in to [data-reveal] elements (threshold 0.12)
        var reveals = document.querySelectorAll('[data-reveal]');
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          }, { threshold: 0.12 });
          reveals.forEach(function (el) { io.observe(el); });
        } else {
          // Fallback: immediately reveal all (no IntersectionObserver support)
          reveals.forEach(function (el) { el.classList.add('in'); });
        }

        // Cursor-follow glow — fine pointer devices only (D-06)
        var glow = document.getElementById('cursor-glow');
        if (glow && window.matchMedia && window.matchMedia('(pointer:fine)').matches) {
          window.addEventListener('mousemove', function (ev) {
            glow.style.transform = 'translate(' + ev.clientX + 'px, ' + ev.clientY + 'px)';
          }, { passive: true });
        }
      })();
    </script>

    <!--
      demo-modal.js — Lessons modal IIFE (D-05 throwaway demo)
      Phase 3 replaces ONLY the submit handler with fetch('/api/book').
      Source file: src/scripts/demo-modal.js
    -->
    <script is:inline>
      (function demoModal() {
        var overlay = document.getElementById('lessons-overlay');
        var dialog = document.getElementById('lessons-dialog');
        var form = document.getElementById('lessons-form');
        var thanks = document.getElementById('lessons-thanks');
        var error = document.getElementById('lessons-error');
        var submitBtn = form ? form.querySelector('[type="submit"]') : null;

        function openLessons() {
          if (!overlay || !form || !thanks) return;
          form.style.display = 'flex';
          thanks.style.display = 'none';
          if (error) error.style.display = 'none';
          form.reset();
          overlay.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        }

        function closeLessons() {
          if (!overlay) return;
          overlay.style.display = 'none';
          document.body.style.overflow = '';
        }

        // Open modal from any [data-open-lessons] trigger (Nav pill + SingSection button)
        document.querySelectorAll('[data-open-lessons]').forEach(function (el) {
          el.addEventListener('click', function (e) {
            e.preventDefault();
            openLessons();
          });
        });

        // Close with × button
        document.querySelectorAll('.lessons-close').forEach(function (el) {
          el.addEventListener('click', closeLessons);
        });

        // Close on click-outside (click on overlay, not dialog)
        if (overlay) {
          overlay.addEventListener('click', function (e) {
            if (e.target === overlay) closeLessons();
          });
        }

        // Prevent clicks inside dialog from bubbling to overlay
        if (dialog) {
          dialog.addEventListener('click', function (e) {
            e.stopPropagation();
          });
        }

        // Close on Escape key
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && overlay && overlay.style.display === 'flex') {
            closeLessons();
          }
        });

        // Real submit — POST to /api/book; success shows thanks, failure shows the
        // non-silent error state with the Telegram fallback link (D-14). Stays is:inline.
        if (form) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var submitText = submitBtn ? submitBtn.textContent : null;
            if (submitBtn) {
              submitBtn.textContent = 'отправляем...';
              submitBtn.setAttribute('disabled', '');
              submitBtn.setAttribute('aria-busy', 'true');
            }
            fetch('/api/book', { method: 'POST', body: new FormData(form) })
              .then(function (res) {
                if (res.ok) {
                  form.style.display = 'none';
                  if (thanks) thanks.style.display = 'block';
                } else {
                  form.style.display = 'none';
                  if (error) error.style.display = 'flex';
                }
              })
              .catch(function () {
                // Network failure → error state, never silent (D-14)
                form.style.display = 'none';
                if (error) error.style.display = 'flex';
              })
              .finally(function () {
                if (submitBtn) {
                  if (submitText) submitBtn.textContent = submitText;
                  submitBtn.removeAttribute('disabled');
                  submitBtn.removeAttribute('aria-busy');
                }
              });
          });
        }

        // Retry — return from error state to the form, values retained (non-destructive)
        if (error) {
          var retryBtn = error.querySelector('.error-retry');
          if (retryBtn) {
            retryBtn.addEventListener('click', function () {
              error.style.display = 'none';
              if (form) form.style.display = 'flex';
            });
          }
        }
      })();
    </script>

    <!--
      theme-toggle.js — Day/night eye toggle handler (Phase 03.1, D-04).
      Mirrors the authoritative design (claude.ai/design 981fc3bc):
        click → eye blinks closed → after ~270ms the theme is applied
        inside a View Transition while the eye reopens in the new colour,
        and a circular clip-path wipe expands from the toggle centre.
      Falls back to a plain swap when View Transitions are unsupported or
      prefers-reduced-motion is set. No-flash init lives in <head>.
    -->
    <script is:inline>
      (function themeToggle() {
        var btns = Array.prototype.slice.call(document.querySelectorAll('[data-theme-toggle]'));
        if (!btns.length) return;
        var root = document.documentElement;
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function syncAria() {
          var isDay = root.getAttribute('data-theme') === 'day';
          btns.forEach(function (b) {
            b.setAttribute('aria-pressed', isDay ? 'true' : 'false');
            b.setAttribute('aria-label', isDay ? 'включить ночную тему' : 'включить дневную тему');
            b.setAttribute('title', isDay ? 'Дневная тема — нажмите для ночной' : 'Ночная тема — нажмите для дневной');
          });
        }
        syncAria();

        // Wire every toggle (desktop in-menu eye + mobile-bar eye)
        btns.forEach(function (btn) {
        var eye = btn.querySelector('.vb-eye');
        // Hover: quick playful blink (skipped if mid-toggle or reduced motion)
        btn.addEventListener('mouseenter', function () {
          if (reduce || !eye || eye.dataset.toggling === '1' || eye.classList.contains('is-blink')) return;
          eye.classList.add('is-blink');
          setTimeout(function () {
            if (eye.dataset.toggling !== '1') eye.classList.remove('is-blink');
          }, 190);
        });

        btn.addEventListener('click', function () {
          var goingDay = root.getAttribute('data-theme') !== 'day';
          function apply() {
            if (goingDay) root.setAttribute('data-theme', 'day');
            else root.removeAttribute('data-theme');
            try { localStorage.setItem('vb-theme', goingDay ? 'day' : 'night'); } catch (e) {}
            syncAria();
          }

          if (eye) { eye.dataset.toggling = '1'; eye.classList.add('is-blink'); } // close the eye

          var r = btn.getBoundingClientRect();
          var x = r.left + r.width / 2;
          var y = r.top + r.height / 2;

          // Hold the closed frame so the blink registers, then reopen in the
          // new colour via the circular wipe.
          setTimeout(function () {
            if (document.startViewTransition && !reduce) {
              var end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
              var t = document.startViewTransition(function () {
                apply();
                if (eye) eye.classList.remove('is-blink');
              });
              t.ready.then(function () {
                root.animate(
                  {
                    clipPath: [
                      'circle(0px at ' + x + 'px ' + y + 'px)',
                      'circle(' + end + 'px at ' + x + 'px ' + y + 'px)'
                    ]
                  },
                  {
                    duration: 620,
                    easing: 'cubic-bezier(.16,.7,.2,1)',
                    pseudoElement: '::view-transition-new(root)'
                  }
                );
              });
              t.finished.finally(function () { if (eye) eye.dataset.toggling = '0'; });
            } else {
              apply();
              if (eye) { eye.classList.remove('is-blink'); eye.dataset.toggling = '0'; }
            }
          }, reduce ? 0 : 270);
        });
        }); // end btns.forEach
      })();
    </script>

    <!--
      mobile-nav.js — burger menu for ≤860px (Phase 03.1 follow-up).
      Opens/closes the .nav-drawer (links + «пойте с нами»). The eye toggle
      stays in the top bar. Closes on link tap, Escape, and outside click.
    -->
    <script is:inline>
      (function mobileNav() {
        var burger = document.querySelector('[data-nav-burger]');
        var overlay = document.querySelector('[data-nav-overlay]');
        if (!burger || !overlay) return;
        var closeBtn = overlay.querySelector('[data-nav-close]');

        function hideOverlay() {
          overlay.classList.remove('open');
          overlay.setAttribute('aria-hidden', 'true');
          burger.setAttribute('aria-expanded', 'false');
          burger.setAttribute('aria-label', 'открыть меню');
        }
        function close() {
          hideOverlay();
          document.body.style.overflow = '';
        }
        function open() {
          overlay.classList.add('open');
          overlay.setAttribute('aria-hidden', 'false');
          burger.setAttribute('aria-expanded', 'true');
          burger.setAttribute('aria-label', 'закрыть меню');
          document.body.style.overflow = 'hidden';
        }

        burger.addEventListener('click', open);
        if (closeBtn) closeBtn.addEventListener('click', close);

        // Tapping a nav link closes the overlay. The «пойте с нами» CTA also has
        // data-open-lessons (demo-modal opens the booking modal) — for that one
        // leave the scroll lock in place so the modal keeps it; the modal's own
        // close restores it.
        overlay.querySelectorAll('.nav-overlay-link').forEach(function (a) {
          a.addEventListener('click', function () {
            if (a.hasAttribute('data-open-lessons')) hideOverlay();
            else close();
          });
        });

        // Escape closes
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && overlay.classList.contains('open')) close();
        });
      })();
    </script>
  </body>
</html>
