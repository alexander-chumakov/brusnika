---
/**
 * HeroSection.astro — Hero header with optimized background image
 *
 * Pixel-faithful port of index.html lines 79-104.
 * Uses Astro <Image> for WebP optimization (D-11 / FND-01).
 *
 * See: RESEARCH.md Pattern 2 (<Image> for local images)
 *      RESEARCH.md Pitfall 6 (whitespace between inline elements)
 */
import { Image } from 'astro:assets';
import heroImg from '../assets/images/hero.jpg';
---

<!-- HERO — port of index.html lines 79-104 -->
<header id="top" class="hero">
  <!-- Optimized hero background image (Astro <Image> → WebP, D-11) -->
  <Image
    src={heroImg}
    alt="внимание брусника!"
    class="hero-bg"
    widths={[640, 1024, 1440, 1920]}
    sizes="100vw"
    format="webp"
    quality={85}
    loading="eager"
    fetchpriority="high"
  />

  <!-- Gradient overlay 1: linear -->
  <div class="hero-overlay-linear"></div>
  <!-- Gradient overlay 2: radial vignette -->
  <div class="hero-overlay-radial"></div>

  <!-- Hero content -->
  <div class="hero-content">
    <!-- Monospace eyebrow -->
    <div class="hero-eyebrow">dream-pop · мтс лейбл</div>

    <!-- Prata heading with gradient text clip — two Cyrillic spans -->
    <h1 class="hero-title">
      <span class="hero-title-line hero-title-line--1">Внимание</span>
      <span class="hero-title-line hero-title-line--2">Брусника!</span>
    </h1>

    <!-- Subtitle paragraph -->
    <p class="hero-subtitle">
      Негромкие песни о любви и о том, что трудно сказать вслух. Размытые плёночные вечера и живой звук.
    </p>

    <!-- CTA row: «слушать» button + animated EQ bars -->
    <!-- flex + gap avoids Astro 7 whitespace-stripping issue (Pitfall 6) -->
    <div class="hero-cta-row">
      <a href="#music" data-play-first class="hero-cta-btn btn-pink">
        <span class="hero-cta-play">▶</span>{' '}слушать
      </a>
      <!-- Animated EQ bars -->
      <div class="hero-eq">
        <span class="hero-eq-bar hero-eq-bar--1"></span>
        <span class="hero-eq-bar hero-eq-bar--2"></span>
        <span class="hero-eq-bar hero-eq-bar--3"></span>
        <span class="hero-eq-bar hero-eq-bar--4"></span>
      </div>
    </div>
  </div>

  <!-- Bobbing down-arrow -->
  <div class="hero-arrow">↓</div>
</header>

<style>
  /* --------------------------------------------------------
     Hero Section — scoped styles
     Layout and component-specific values reference global tokens.
     -------------------------------------------------------- */

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    z-index: 2;
    overflow: hidden;
  }

  /* Background image — Astro <Image> output */
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
    filter: grayscale(0.1) contrast(1.04);
  }

  /* Gradient overlays */
  .hero-overlay-linear {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--color-hero-gradient-top) 0%,
      rgba(0, 0, 0, 0.22) 44%,
      var(--color-hero-gradient-bottom) 100%
    );
  }

  .hero-overlay-radial {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      62% 62% at 50% 46%,
      rgba(0, 0, 0, 0) 38%,
      rgba(0, 0, 0, 0.42) 100%
    );
  }

  /* Content container */
  .hero-content {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1100px;
    padding: 120px 40px 70px;
  }

  /* Monospace eyebrow */
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 30px;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.55);
    animation: riseup 0.7s ease both;
  }

  /* Prata heading */
  .hero-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(40px, 11vw, 150px);
    line-height: 0.9;
    margin: 0;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Gradient text clip applied to each span */
  .hero-title-line {
    display: block;
    /* Solid fallback — guarantees the name is readable if gradient-clip
       is unsupported or fails to paint (e.g. some tablet browsers). */
    color: var(--color-accent);
  }

  /* Apply the gradient clip only where the browser actually supports it. */
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .hero-title-line {
      background: linear-gradient(176deg, #ffe7ed 4%, var(--color-accent) 58%, #dd7791 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
  }

  .hero-title-line--1 {
    animation: riseup 0.8s ease both;
    animation-delay: 0.05s;
  }

  .hero-title-line--2 {
    animation: riseup 0.9s ease both;
    animation-delay: 0.14s;
  }

  /* Subtitle */
  .hero-subtitle {
    max-width: 540px;
    margin: 34px auto 0;
    font-size: clamp(16px, 2.1vw, 21px);
    line-height: 1.6;
    /* On the hero photo in BOTH themes → constant light + shadow (the day
       veil turns the lower hero cream, so a themed dark colour would vanish). */
    color: #f4efe8;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.65);
    animation: riseup 1s ease both;
    animation-delay: 0.22s;
  }

  /* CTA row */
  .hero-cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    margin-top: 40px;
    animation: riseup 1.1s ease both;
    animation-delay: 0.3s;
  }

  /* «слушать» button */
  .hero-cta-btn {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 11px;
    background: var(--color-accent);
    color: var(--color-text-on-accent);
    font-weight: 600;
    font-size: 15px;
    padding: 14px 30px;
    border-radius: 2px;
    letter-spacing: 0.3px;
  }

  .hero-cta-play {
    font-size: 11px;
  }

  /* Animated EQ bars */
  .hero-eq {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 26px;
  }

  .hero-eq-bar {
    width: 3px;
    height: 100%;
    background: var(--color-accent);
    border-radius: 2px;
    transform-origin: bottom;
  }

  .hero-eq-bar--1 {
    animation: eq 1s ease-in-out infinite;
  }

  .hero-eq-bar--2 {
    animation: eq 1.1s ease-in-out infinite;
    animation-delay: 0.2s;
  }

  .hero-eq-bar--3 {
    animation: eq 0.85s ease-in-out infinite;
    animation-delay: 0.4s;
  }

  .hero-eq-bar--4 {
    animation: eq 1.2s ease-in-out infinite;
    animation-delay: 0.1s;
  }

  /* Bobbing down-arrow */
  .hero-arrow {
    position: absolute;
    left: 50%;
    bottom: 26px;
    transform: translateX(-50%);
    font-size: 20px;
    color: var(--color-accent);
    animation: bobdown 1.8s ease-in-out infinite;
    z-index: 3;
  }
</style>
