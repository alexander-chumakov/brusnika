---
/**
 * Nav.astro — Fixed top navigation bar
 *
 * Pixel-faithful port of index.html lines 64-76.
 * - Backdrop blur + translucent black background
 * - Logo: 9px pink dot with glow + Prata wordmark
 * - .nav-menu: four .nav-link anchors (релизы, клипы, о группе, концерты) + «пойте с нами» pink pill
 * - Pill carries data-open-lessons (wired in Plan 04)
 * - Mobile: .nav-menu hidden at 860px (FND-04; also covered by global.css)
 */
---

<nav>
  <a href="#top" class="nav-logo">
    <span class="nav-dot"></span>
    <span class="nav-wordmark">внимание брусника!</span>
  </a>
  <div class="nav-menu">
    <a href="#music" class="nav-link">релизы</a>
    <a href="#clips" class="nav-link">клипы</a>
    <a href="#about" class="nav-link">о группе</a>
    <a href="#shows" class="nav-link">концерты</a>
    <a href="#sing" class="nav-pill" data-open-lessons>пойте с нами</a>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 40px;
    backdrop-filter: blur(16px);
    background: rgba(0, 0, 0, 0.5);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .nav-logo {
    text-decoration: none;
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .nav-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-accent);
    display: inline-block;
    box-shadow: 0 0 12px rgba(243, 169, 189, 0.9);
    flex-shrink: 0;
  }

  .nav-wordmark {
    font-family: var(--font-serif);
    font-size: 18px;
    letter-spacing: 0.5px;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  /* .nav-link hover/color defined in global.css */
  .nav-link {
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 0.3px;
  }

  .nav-pill {
    text-decoration: none;
    color: #000;
    background: var(--color-accent);
    font-size: 13.5px;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: 2px;
    letter-spacing: 0.3px;
    transition: background 0.25s;
  }

  .nav-pill:hover {
    background: var(--color-accent-hover);
  }

  /* Mobile: hide nav menu at 860px — also covered by global.css but
     scoped here for co-location clarity (the !important in global.css wins) */
  @media (max-width: 860px) {
    nav {
      padding: 14px 20px;
    }

    .nav-menu {
      display: none;
    }
  }
</style>
