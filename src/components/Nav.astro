---
/**
 * Nav.astro — Fixed top navigation bar
 *
 * Pixel-faithful port of index.html lines 64-76.
 * - Backdrop blur + translucent background (themed via --color-surface-nav)
 * - Logo: 9px pink dot with glow + Prata wordmark
 * - .nav-menu: four .nav-link anchors (релизы, клипы, о группе, концерты) + «пойте с нами» pink pill
 * - Pill carries data-open-lessons (wired in Plan 04)
 * - .theme-toggle: the brand "eye" day/night switch (Phase 03.1, D-03/D-04).
 *   Placed OUTSIDE .nav-menu so it stays visible when the menu is hidden
 *   at ≤860px. Handler + no-flash init live in Layout.astro.
 * - Mobile: .nav-menu hidden at 860px (FND-04; also covered by global.css)
 */
import eyePhoto from '../assets/eye-photo.jpg';
---

<nav>
  <a href="#top" class="nav-logo">
    <span class="nav-dot"></span>
    <span class="nav-wordmark">внимание брусника!</span>
  </a>
  <div class="nav-right">
    <div class="nav-menu">
      <a href="#music" class="nav-link">релизы</a>
      <a href="#clips" class="nav-link">клипы</a>
      <a href="#about" class="nav-link">о группе</a>
      <a href="#shows" class="nav-link">концерты</a>
      <a href="#sing" class="nav-pill" data-open-lessons>пойте с нами</a>
    </div>
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      title="день / ночь"
      aria-label="сменить тему"
      aria-pressed="false"
    >
      <span class="vb-eye">
        <img src={eyePhoto.src} alt="" width="48" height="48" loading="eager" decoding="async" />
      </span>
    </button>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 40px;
    backdrop-filter: blur(16px);
    background: var(--color-surface-nav);
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background 0.4s ease;
  }

  .nav-logo {
    text-decoration: none;
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .nav-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-accent);
    display: inline-block;
    box-shadow: 0 0 12px rgba(243, 169, 189, 0.9);
    flex-shrink: 0;
  }

  .nav-wordmark {
    font-family: var(--font-serif);
    font-size: 18px;
    letter-spacing: 0.5px;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  /* .nav-link hover/color defined in global.css */
  .nav-link {
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 0.3px;
  }

  .nav-pill {
    text-decoration: none;
    color: var(--color-text-on-accent);
    background: var(--color-accent);
    font-size: 13.5px;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: 2px;
    letter-spacing: 0.3px;
    transition: background 0.25s;
  }

  .nav-pill:hover {
    background: var(--color-accent-hover);
  }

  /* Day/night eye toggle (.vb-eye visual lives in global.css) */
  .theme-toggle {
    all: unset;
    cursor: pointer;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  .theme-toggle:hover {
    opacity: 0.92;
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Mobile: hide nav menu at 860px (the eye toggle stays visible —
     it is a sibling of .nav-menu, not a child). global.css !important wins. */
  @media (max-width: 860px) {
    nav {
      padding: 14px 20px;
    }

    .nav-menu {
      display: none;
    }
  }
</style>
